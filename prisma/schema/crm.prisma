// ───────────────────────────── CRM & Sales OS ─────────────────────────────
// Pipelines, deals, generalized sales activities, follow-ups, attachments, custom fields, segments, automation rules,
// sales targets and commission rules. Permissions: sales.read / sales.manage. Leads, LeadFollowUp and LeadActivity live
// in core.prisma; Account and Contact in shared.prisma (all owned by the CRM module). Users (owners) are referenced by
// id only (names are looked up), to keep the User model free of CRM back-relations.

enum CrmStageType {
  OPEN
  WON
  LOST
}

enum CrmDealStatus {
  OPEN
  WON
  LOST
}

enum CrmEntity {
  LEAD
  CONTACT
  ACCOUNT
  DEAL
}

enum CrmFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

enum CrmAssignmentStrategy {
  ROUND_ROBIN
  FIXED
}

enum CrmTargetPeriod {
  MONTH
  QUARTER
}

/// A sales pipeline (a company may run several, e.g. "New business" and "Renewals").
model CrmPipeline {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String
  isDefault      Boolean   @default(false) @map("is_default")
  position       Int       @default(0)
  /// Open deals with no stage change for this many days are flagged stale by the daily job.
  staleDays      Int       @default(30) @map("stale_days")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company         Company             @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  stages          CrmPipelineStage[]
  deals           CrmDeal[]
  commissionRules CrmCommissionRule[]

  @@unique([id, companyId])
  @@index([organizationId, companyId])
  @@map("crm_pipelines")
}

/// An ordered stage of a pipeline with a default win probability; WON/LOST stages close the deal.
model CrmPipelineStage {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  pipelineId     String       @map("pipeline_id") @db.Uuid
  name           String
  position       Int          @default(0)
  probability    Int          @default(10)
  type           CrmStageType @default(OPEN)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company        @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  pipeline CrmPipeline    @relation(fields: [pipelineId, companyId], references: [id, companyId], onDelete: Cascade)
  deals    CrmDeal[]
  rules    CrmStageRule[]

  @@unique([id, companyId])
  @@index([pipelineId, position])
  @@map("crm_pipeline_stages")
}

/// An opportunity: amount in minor units of `currency`, in a pipeline stage, optionally for an account/contact.
model CrmDeal {
  id                String        @id @default(uuid(7)) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  companyId         String        @map("company_id") @db.Uuid
  name              String
  accountId         String?       @map("account_id") @db.Uuid
  contactId         String?       @map("contact_id") @db.Uuid
  /// Lead this deal was converted from.
  leadId            String?       @map("lead_id") @db.Uuid
  ownerId           String?       @map("owner_id") @db.Uuid
  pipelineId        String        @map("pipeline_id") @db.Uuid
  stageId           String        @map("stage_id") @db.Uuid
  amountMinor       BigInt        @default(0) @map("amount_minor")
  currency          String        @db.Char(3)
  /// 0–100; null means the stage's probability.
  probability       Int?
  expectedCloseDate DateTime?     @map("expected_close_date") @db.Date
  status            CrmDealStatus @default(OPEN)
  closedAt          DateTime?     @map("closed_at") @db.Timestamptz(3)
  lostReason        String?       @map("lost_reason")
  source            String?
  campaignCode      String?       @map("campaign_code")
  description       String?
  tags              String[]      @default([])
  customFields      Json          @default("{}") @map("custom_fields")
  stageEnteredAt    DateTime      @default(now()) @map("stage_entered_at") @db.Timestamptz(3)
  /// Set by the daily job when an open deal sat in its stage longer than the pipeline's staleDays.
  staleSince        DateTime?     @map("stale_since") @db.Timestamptz(3)
  archivedAt        DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdById       String        @map("created_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company              @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  account      Account?             @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: NoAction)
  contact      Contact?             @relation(fields: [contactId, companyId], references: [id, companyId], onDelete: NoAction)
  lead         Lead?                @relation(fields: [leadId, companyId], references: [id, companyId], onDelete: NoAction)
  pipeline     CrmPipeline          @relation(fields: [pipelineId, companyId], references: [id, companyId], onDelete: NoAction)
  stage        CrmPipelineStage     @relation(fields: [stageId, companyId], references: [id, companyId], onDelete: NoAction)
  activities   CrmActivity[]
  followUps    CrmFollowUp[]
  attachments  CrmAttachment[]
  stageHistory CrmDealStageChange[]

  @@unique([id, companyId])
  @@index([organizationId, companyId, status])
  @@index([pipelineId, stageId])
  @@index([companyId, ownerId])
  @@index([accountId])
  @@index([contactId])
  @@map("crm_deals")
}

/// Every stage move of a deal (sales-cycle and stage analytics).
model CrmDealStageChange {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  fromStageId    String?  @map("from_stage_id") @db.Uuid
  toStageId      String   @map("to_stage_id") @db.Uuid
  changedById    String?  @map("changed_by_id") @db.Uuid
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  deal    CrmDeal @relation(fields: [dealId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([dealId, changedAt])
  @@map("crm_deal_stage_changes")
}

/// A logged call, email, meeting, note or task on a contact, account and/or deal (leads keep LeadActivity).
model CrmActivity {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  type           CrmActivityType
  subject        String?
  summary        String
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz(3)
  durationMin    Int?            @map("duration_min")
  contactId      String?         @map("contact_id") @db.Uuid
  accountId      String?         @map("account_id") @db.Uuid
  dealId         String?         @map("deal_id") @db.Uuid
  createdById    String          @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId, companyId], references: [id, companyId], onDelete: NoAction)
  account Account? @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: NoAction)
  deal    CrmDeal? @relation(fields: [dealId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([organizationId, companyId, occurredAt])
  @@index([contactId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([dealId, occurredAt])
  @@map("crm_activities")
}

/// A follow-up / reminder on a contact, account or deal, assigned to a user (leads keep LeadFollowUp).
model CrmFollowUp {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  dueAt          DateTime         @map("due_at") @db.Timestamptz(3)
  note           String
  priority       FollowUpPriority @default(MEDIUM)
  assigneeId     String?          @map("assignee_id") @db.Uuid
  contactId      String?          @map("contact_id") @db.Uuid
  accountId      String?          @map("account_id") @db.Uuid
  dealId         String?          @map("deal_id") @db.Uuid
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(3)
  /// Last time the reminder job notified the assignee (at most once per day).
  remindedAt     DateTime?        @map("reminded_at") @db.Timestamptz(3)
  createdById    String           @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId, companyId], references: [id, companyId], onDelete: NoAction)
  account Account? @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: NoAction)
  deal    CrmDeal? @relation(fields: [dealId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, completedAt, dueAt])
  @@index([assigneeId, completedAt])
  @@index([dealId])
  @@map("crm_follow_ups")
}

/// A small file (≤ 5 MB) attached to a lead, contact, account or deal, stored in the database.
model CrmAttachment {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String
  mimeType       String   @map("mime_type")
  size           Int
  data           Bytes
  leadId         String?  @map("lead_id") @db.Uuid
  contactId      String?  @map("contact_id") @db.Uuid
  accountId      String?  @map("account_id") @db.Uuid
  dealId         String?  @map("deal_id") @db.Uuid
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  lead    Lead?    @relation(fields: [leadId, companyId], references: [id, companyId], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId, companyId], references: [id, companyId], onDelete: Cascade)
  account Account? @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: Cascade)
  deal    CrmDeal? @relation(fields: [dealId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, leadId])
  @@index([companyId, contactId])
  @@index([companyId, accountId])
  @@index([companyId, dealId])
  @@map("crm_attachments")
}

/// Managed list of lead/deal sources ("Website", "Referral", ...).
model CrmLeadSource {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String
  position       Int       @default(0)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("crm_lead_sources")
}

/// A custom field shown in the forms of one CRM entity; values live in the entity's `customFields` JSON by `key`.
model CrmCustomField {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  entity         CrmEntity
  key            String
  label          String
  type           CrmFieldType @default(TEXT)
  options        String[]     @default([])
  required       Boolean      @default(false)
  position       Int          @default(0)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([companyId, entity, key])
  @@map("crm_custom_fields")
}

/// A saved filter over leads or contacts (the query string of the list page).
model CrmSegment {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  entity         CrmEntity
  name           String
  /// { q, owner, stage, temperature, tag, source, type, qualified } — same keys as the list page filters.
  filters        Json      @default("{}")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([companyId, entity])
  @@map("crm_segments")
}

/// Assigns new unowned leads: round-robin among `ownerIds` (or always the first) when the source/territory match.
model CrmAssignmentRule {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  companyId      String                @map("company_id") @db.Uuid
  name           String
  strategy       CrmAssignmentStrategy @default(ROUND_ROBIN)
  ownerIds       String[]              @map("owner_ids") @db.Uuid
  /// Match leads with this source (case-insensitive); null matches any.
  matchSource    String?               @map("match_source")
  /// Match leads with this territory (case-insensitive); null matches any.
  matchTerritory String?               @map("match_territory")
  /// Round-robin cursor: total assignments made by this rule.
  assignedCount  Int                   @default(0) @map("assigned_count")
  position       Int                   @default(0)
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([companyId, active, position])
  @@map("crm_assignment_rules")
}

/// What happens when a deal enters a stage: a follow-up for the owner, a WorkTask, a notification.
model CrmStageRule {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  stageId        String   @map("stage_id") @db.Uuid
  name           String
  createFollowUp Boolean  @default(false) @map("create_follow_up")
  followUpDays   Int      @default(2) @map("follow_up_days")
  followUpNote   String?  @map("follow_up_note")
  createWorkTask Boolean  @default(false) @map("create_work_task")
  workTaskTitle  String?  @map("work_task_title")
  notifyOwner    Boolean  @default(true) @map("notify_owner")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company          @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  stage   CrmPipelineStage @relation(fields: [stageId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([stageId, active])
  @@map("crm_stage_rules")
}

/// A revenue (and optionally deal-count) target for one owner and one month or quarter.
model CrmSalesTarget {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  ownerId        String          @map("owner_id") @db.Uuid
  period         CrmTargetPeriod @default(MONTH)
  /// First day of the month / quarter.
  periodStart    DateTime        @map("period_start") @db.Date
  amountMinor    BigInt          @map("amount_minor")
  currency       String          @db.Char(3)
  dealsTarget    Int?            @map("deals_target")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([companyId, ownerId, period, periodStart])
  @@map("crm_sales_targets")
}

/// Commission rule: a percentage (basis points) of won amount, optionally per pipeline/owner, with tiers
/// [{ fromMinor, rateBps }] applied progressively to the owner's won amount in the period.
model CrmCommissionRule {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String
  rateBps        Int      @map("rate_bps")
  pipelineId     String?  @map("pipeline_id") @db.Uuid
  ownerId        String?  @map("owner_id") @db.Uuid
  tiers          Json     @default("[]")
  active         Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company      @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  pipeline CrmPipeline? @relation(fields: [pipelineId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, active])
  @@map("crm_commission_rules")
}
