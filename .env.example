# Copy to .env (never commit .env). Values here are names/placeholders only.
DATABASE_URL="postgresql://realy:realy@localhost:5432/realy"
REDIS_URL="redis://localhost:6379"
# 32 random bytes, base64. Generate: openssl rand -base64 32
REALY_ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"
# Development only: allow MFA-gated admin actions without MFA. Refused when NODE_ENV=production.
REALY_DEV_RELAX_MFA="false"
# Optional providers — features report "not configured" when absent.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""
SENTRY_DSN=""
