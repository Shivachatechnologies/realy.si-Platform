# Copy to .env (never commit .env). Values here are names/placeholders only.
DATABASE_URL="postgresql://realy:realy@localhost:5432/realy"
# Optional for the web app in production (rate limits fall back to Postgres); required by the worker.
REDIS_URL="redis://localhost:6379"
# 32 random bytes, base64. Generate: openssl rand -base64 32
REALY_ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"
# Vercel builds run `prisma migrate deploy` + the reference-data seed (scripts/deploy-db.mjs) before `next build`.
# DIRECT_DATABASE_URL: optional non-pooled URL for migrations (Neon: the URL without "-pooler"). SKIP_DB_MIGRATIONS=true skips the step.
DIRECT_DATABASE_URL=""
SKIP_DB_MIGRATIONS=""
# First-run access: this email becomes platform SUPER_ADMIN when it registers while no SUPER_ADMIN exists.
# Unset: only the very first account on an empty database qualifies. Remove it once your admin exists.
REALY_BOOTSTRAP_ADMIN_EMAIL=""

# Two apps (docs/architecture/apps.md): apps/user (app.realy.si) and apps/admin (admin.realy.si).
#   user app:  ADMIN_URL="https://admin.example.com"    (links + redirects /[locale]/admin/** to the console)
#   admin app: USER_APP_URL="https://app.example.com"  (links back into the product)
ADMIN_URL=""
USER_APP_URL=""
# Reverse proxies in front of the app that append to X-Forwarded-For (client IP = entry N from the right).
# Required in production. Run behind at least one proxy: with 0 the header is ignored and all clients
# share one per-IP rate-limit bucket; never set it higher than the real number of proxies.
TRUSTED_PROXY_HOPS="1"
# Development only: allow MFA-gated admin actions without MFA. Refused when NODE_ENV=production.
REALY_DEV_RELAX_MFA="false"

# ── Optional services: each feature shows "not configured" until set ──
# Billing (Stripe). Webhook endpoint: {APP_URL}/api/v1/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_AUTOMATIC_TAX="false"
# Email: resend | postmark
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""
# OAuth login. Redirect URI: {APP_URL}/api/v1/auth/oauth/{google|github|microsoft}/callback
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""
OAUTH_MICROSOFT_CLIENT_ID=""
OAUTH_MICROSOFT_CLIENT_SECRET=""
OAUTH_MICROSOFT_TENANT="common"
# Integrations OS (provider connections). Google and Microsoft reuse OAUTH_GOOGLE_* / OAUTH_MICROSOFT_* above.
# Register this redirect URI with each provider: {APP_URL}/api/v1/integrations/oauth/{provider}/callback
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
# SALESFORCE_LOGIN_URL="https://login.salesforce.com"   (https://test.salesforce.com for sandboxes)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
# Facebook and Instagram share one Meta app.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
# QUICKBOOKS_ENVIRONMENT="production"   (or "sandbox")
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
# YouTube, Google Search Console and Google Ads reuse OAUTH_GOOGLE_*; Meta Ads reuses FACEBOOK_APP_*; LinkedIn Ads reuses LINKEDIN_*.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
# TikTok for Business (Marketing API) app
TIKTOK_ADS_APP_ID=""
TIKTOK_ADS_APP_SECRET=""
# Optional: lets companies connect Mailchimp with OAuth instead of an API key
MAILCHIMP_CLIENT_ID=""
MAILCHIMP_CLIENT_SECRET=""
# Google Ads API developer token (manager account); companies can override it on their connection
GOOGLE_ADS_DEVELOPER_TOKEN=""
# GOOGLE_ADS_API_VERSION="v21"
# Observability
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# AI task execution (Claude API). Optional: without a key the AI Tasks page says "not configured".
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# Daily AI token allowance per company (0 = unlimited).
# AI_DAILY_TOKEN_LIMIT=2000000
