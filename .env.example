# Copy to .env (never commit .env). Values here are names/placeholders only.
DATABASE_URL="postgresql://realy:realy@localhost:5432/realy"
REDIS_URL="redis://localhost:6379"
# 32 random bytes, base64. Generate: openssl rand -base64 32
REALY_ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"
# Reverse proxies in front of the app (client IP = X-Forwarded-For entry N hops from the right). 0 = ignore XFF.
TRUSTED_PROXY_HOPS="1"
# Development only: allow MFA-gated admin actions without MFA. Refused when NODE_ENV=production.
REALY_DEV_RELAX_MFA="false"

# ── Optional services: each feature shows "not configured" until set ──
# Billing (Stripe). Webhook endpoint: {APP_URL}/api/v1/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_AUTOMATIC_TAX="false"
# Email: resend | postmark
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""
# OAuth login. Redirect URI: {APP_URL}/api/v1/auth/oauth/{google|github|microsoft}/callback
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""
OAUTH_MICROSOFT_CLIENT_ID=""
OAUTH_MICROSOFT_CLIENT_SECRET=""
OAUTH_MICROSOFT_TENANT="common"
# Observability
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
