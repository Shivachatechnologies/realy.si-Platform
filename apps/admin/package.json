{
  "name": "@realy/admin",
  "version": "0.1.0",
  "private": true,
  "description": "Realy Control Center (admin.realy.si): platform administration only. Never runs database migrations.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "pnpm --filter @realy/database run generate && NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start -p 3001",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@realy/api-client": "workspace:*",
    "@realy/auth-core": "workspace:*",
    "@realy/backend": "workspace:*",
    "@realy/shared-utils": "workspace:*",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.57.0",
    "motion": "14.14.0",
    "next": "16.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
