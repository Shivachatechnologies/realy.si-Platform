// ───────────────────────────── Platform keys ─────────────────────────────
// Platform-level API keys and settings entered in Admin → Settings → Platform keys instead of host env vars
// (docs/platform-keys.md). `key` is an env var name from the allow-list in
// packages/backend/src/server/core/platform-secrets-catalog.ts; bootstrap variables (DATABASE_URL,
// REALY_ENCRYPTION_KEY, …) can never be stored here. Overlaid onto process.env at runtime (DB wins over host env).

/// One platform key. The value is AES-256-GCM encrypted (purpose "platform-secret") and is never returned by any API.
model PlatformSecret {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// Env var name (allow-listed), e.g. "ANTHROPIC_API_KEY".
  key            String   @unique
  valueEncrypted String   @map("value_encrypted")
  /// Last 4 characters, for recognising which key is active (empty for short plain values).
  last4          String   @default("")
  note           String?
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("platform_secrets")
}
