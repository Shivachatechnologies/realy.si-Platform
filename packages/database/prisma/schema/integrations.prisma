// Integrations OS (src/server/modules/integrations). Provider connections with encrypted credentials, sync runs,
// incoming webhooks (hooks) and outbound webhook subscriptions with their delivery logs.

enum IntegrationConnectionStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

enum IntegrationSyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum IntegrationHookVerification {
  TOKEN
  HMAC_SHA256
  /// Provider presets: the provider's own signature scheme with the signing secret it issued.
  STRIPE
  GITHUB
  SHOPIFY
  SLACK
  TWILIO
  CALENDLY
  META
  ELEVENLABS
  ZENDESK
  INTERCOM
}

enum IntegrationHookDeliveryStatus {
  ACCEPTED
  REJECTED
}

enum IntegrationWebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One connection per provider per company. Secrets live only in `credentialsEnc` (AES-256-GCM, never returned).
model IntegrationConnection {
  id                  String                      @id @default(uuid(7)) @db.Uuid
  organizationId      String                      @map("organization_id") @db.Uuid
  companyId           String                      @map("company_id") @db.Uuid
  provider            String
  status              IntegrationConnectionStatus @default(CONNECTED)
  /// Encrypted JSON { accessToken?, refreshToken?, apiKey? }.
  credentialsEnc      String?                     @map("credentials_enc")
  tokenExpiresAt      DateTime?                   @map("token_expires_at") @db.Timestamptz(3)
  scopes              String[]                    @default([])
  /// Non-secret settings (phone number id, base URL, instance URL, tenant id...).
  config              Json                        @default("{}")
  /// Display label of the connected account (email, workspace or account name).
  externalAccount     String?                     @map("external_account")
  syncEnabled         Boolean                     @default(false) @map("sync_enabled")
  syncIntervalMinutes Int                         @default(60) @map("sync_interval_minutes")
  nextSyncAt          DateTime?                   @map("next_sync_at") @db.Timestamptz(3)
  lastSyncAt          DateTime?                   @map("last_sync_at") @db.Timestamptz(3)
  syncCursor          Json                        @default("{}") @map("sync_cursor")
  lastError           String?                     @map("last_error")
  lastErrorAt         DateTime?                   @map("last_error_at") @db.Timestamptz(3)
  lastTestedAt        DateTime?                   @map("last_tested_at") @db.Timestamptz(3)
  /// Health of provider calls (any module's calls through providerFetch / the provider services).
  lastSuccessAt       DateTime?                   @map("last_success_at") @db.Timestamptz(3)
  lastFailureAt       DateTime?                   @map("last_failure_at") @db.Timestamptz(3)
  /// Consecutive failed calls; the connection is marked ERROR (and managers notified) at the threshold.
  errorStreak         Int                         @default(0) @map("error_streak")
  connectedById       String                      @map("connected_by_id") @db.Uuid
  connectedAt         DateTime                    @default(now()) @map("connected_at") @db.Timestamptz(3)
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company          Company                      @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  syncRuns         IntegrationSyncRun[]
  requestLogs      IntegrationRequestLog[]
  externalRefs     IntegrationExternalRef[]
  providerEvents   IntegrationProviderEvent[]
  bankAccounts     IntegrationBankAccount[]
  bankTransactions IntegrationBankTransaction[]

  @@unique([id, companyId])
  @@unique([companyId, provider])
  @@index([organizationId, companyId, status])
  @@index([syncEnabled, nextSyncAt])
  @@map("integration_connections")
}

model IntegrationSyncRun {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  companyId      String                @map("company_id") @db.Uuid
  connectionId   String                @map("connection_id") @db.Uuid
  provider       String
  /// What was synced, e.g. "stripe.payments", "hubspot.contacts".
  kind           String
  /// "manual" or "scheduled".
  trigger        String
  status         IntegrationSyncStatus @default(RUNNING)
  itemsRead      Int                   @default(0) @map("items_read")
  itemsCreated   Int                   @default(0) @map("items_created")
  itemsUpdated   Int                   @default(0) @map("items_updated")
  itemsSkipped   Int                   @default(0) @map("items_skipped")
  errorCount     Int                   @default(0) @map("error_count")
  /// [{ message, ref? }] (no secrets, truncated).
  errors         Json                  @default("[]")
  startedAt      DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?             @map("finished_at") @db.Timestamptz(3)

  company    Company               @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([organizationId, companyId, startedAt])
  @@index([connectionId, startedAt])
  @@map("integration_sync_runs")
}

/// Incoming webhook endpoint: POST {APP_URL}/api/v1/hooks/{id}, verified by a secret token or an HMAC signature.
model IntegrationHook {
  id              String                      @id @default(uuid(7)) @db.Uuid
  organizationId  String                      @map("organization_id") @db.Uuid
  companyId       String                      @map("company_id") @db.Uuid
  name            String
  verification    IntegrationHookVerification @default(TOKEN)
  /// Header carrying the HMAC signature (HMAC_SHA256 mode).
  signatureHeader String                      @default("x-realy-signature") @map("signature_header")
  secretEnc       String                      @map("secret_enc")
  active          Boolean                     @default(true)
  lastReceivedAt  DateTime?                   @map("last_received_at") @db.Timestamptz(3)
  createdById     String                      @map("created_by_id") @db.Uuid
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company                   @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  deliveries IntegrationHookDelivery[]

  @@unique([id, companyId])
  @@index([organizationId, companyId])
  @@map("integration_hooks")
}

model IntegrationHookDelivery {
  id             String                        @id @default(uuid(7)) @db.Uuid
  organizationId String                        @map("organization_id") @db.Uuid
  companyId      String                        @map("company_id") @db.Uuid
  hookId         String                        @map("hook_id") @db.Uuid
  status         IntegrationHookDeliveryStatus
  /// Truncated request body (accepted deliveries only).
  body           String?
  contentType    String?                       @map("content_type")
  error          String?
  eventId        String?                       @map("event_id") @db.Uuid
  ip             String?
  receivedAt     DateTime                      @default(now()) @map("received_at") @db.Timestamptz(3)

  company Company         @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  hook    IntegrationHook @relation(fields: [hookId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([hookId, receivedAt])
  @@map("integration_hook_deliveries")
}

/// Outbound webhook subscription: domain events of the company are POSTed, signed, to `url`.
model IntegrationWebhookSubscription {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String
  url            String
  /// Domain event types, or ["*"] for all.
  eventTypes     String[] @map("event_types")
  secretEnc      String   @map("secret_enc")
  active         Boolean  @default(true)
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company                      @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  deliveries IntegrationWebhookDelivery[]

  @@unique([id, companyId])
  @@index([organizationId, companyId, active])
  @@map("integration_webhook_subscriptions")
}

model IntegrationWebhookDelivery {
  id             String                           @id @default(uuid(7)) @db.Uuid
  organizationId String                           @map("organization_id") @db.Uuid
  companyId      String                           @map("company_id") @db.Uuid
  subscriptionId String                           @map("subscription_id") @db.Uuid
  eventId        String                           @map("event_id") @db.Uuid
  eventType      String                           @map("event_type")
  payload        Json
  status         IntegrationWebhookDeliveryStatus @default(PENDING)
  attempts       Int                              @default(0)
  nextAttemptAt  DateTime?                        @map("next_attempt_at") @db.Timestamptz(3)
  lastStatusCode Int?                             @map("last_status_code")
  lastError      String?                          @map("last_error")
  deliveredAt    DateTime?                        @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company                        @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  subscription IntegrationWebhookSubscription @relation(fields: [subscriptionId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
  @@index([subscriptionId, createdAt])
  @@map("integration_webhook_deliveries")
}

/// One provider API call made through a connection (request/response summaries only: no headers, tokens or bodies).
model IntegrationRequestLog {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  connectionId    String   @map("connection_id") @db.Uuid
  provider        String
  method          String
  /// Host and path; the query string is dropped (it may carry identifiers or filters).
  url             String
  /// HTTP status, null when the request never got a response.
  status          Int?
  durationMs      Int      @map("duration_ms")
  attempts        Int      @default(1)
  /// Short, secret-free summary of the request (e.g. "JSON body, 3 keys").
  requestSummary  String?  @map("request_summary")
  /// Short, secret-free summary of the response (size, content type, provider error code).
  responseSummary String?  @map("response_summary")
  error           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company    Company               @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([organizationId, companyId, createdAt])
  @@map("integration_request_logs")
}

/// Mapping of an imported external record (QuickBooks / Xero id) to the Realy record it created.
model IntegrationExternalRef {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  /// "customer" | "invoice".
  kind           String
  externalId     String   @map("external_id")
  /// "account" | "contact" | "invoice".
  internalType   String   @map("internal_type")
  internalId     String   @map("internal_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company    Company               @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([connectionId, kind, externalId])
  @@map("integration_external_refs")
}

enum IntegrationUsageStatus {
  SUCCEEDED
  FAILED
}

/// Metered use of a provider by the generic provider services (research, AI text, images, video, storage, SMS,
/// payments, email). Cost is an estimate in micro-USD from public list prices; null when unknown.
model IntegrationUsage {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  companyId           String                 @map("company_id") @db.Uuid
  connectionId        String?                @map("connection_id") @db.Uuid
  provider            String
  /// e.g. "research.search", "ai.text", "images.generate", "video.start", "storage.put", "sms.send".
  operation           String
  units               Int                    @default(1)
  /// What `units` counts: "request", "token", "image", "second", "byte", "message".
  unit                String                 @default("request")
  estimatedCostMicros Int?                   @map("estimated_cost_micros")
  status              IntegrationUsageStatus
  error               String?
  /// Non-secret details (model, size, job id...).
  meta                Json                   @default("{}")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, companyId, createdAt])
  @@index([connectionId, createdAt])
  @@map("integration_usage")
}

/// Database fallback of the storage service when no S3-compatible bucket is connected (bounded object size).
model IntegrationStoredObject {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  key            String
  contentType    String   @map("content_type")
  size           Int
  data           Bytes
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([organizationId, companyId, createdAt])
  @@map("integration_stored_objects")
}

/// A webhook / status callback a provider sent for a connection (Calendly invitee, Twilio call status and recordings,
/// Plaid item updates, WhatsApp statuses, render / generation callbacks). Signature-verified before it is stored;
/// payloads are reduced to a secret-free summary. Deduplicated per connection by the provider's event key.
model IntegrationProviderEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  connectionId   String    @map("connection_id") @db.Uuid
  provider       String
  /// Provider event type, e.g. "invitee.created", "call.completed", "TRANSACTIONS:SYNC_UPDATES_AVAILABLE".
  eventType      String    @map("event_type")
  /// Provider-side id used for idempotency (invitee URI, CallSid + status, webhook id...).
  dedupeKey      String    @map("dedupe_key")
  /// "processed" | "stored" | "ignored" | "failed".
  status         String
  /// Short secret-free summary (ids, statuses, durations), never raw bodies with personal data beyond what is needed.
  summary        Json      @default("{}")
  /// Realy record the event created or updated ("crm_meeting:<id>"), when any.
  resultRef      String?   @map("result_ref")
  error          String?
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([connectionId, dedupeKey])
  @@index([organizationId, companyId, receivedAt])
  @@index([connectionId, receivedAt])
  @@map("integration_provider_events")
}

/// A bank / money account read from a bank-feed provider (Plaid item account, Wise balance). Read-only mirror.
model IntegrationBankAccount {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  connectionId      String    @map("connection_id") @db.Uuid
  provider          String
  /// Plaid item id / Wise profile id the account belongs to.
  itemId            String    @map("item_id")
  externalAccountId String    @map("external_account_id")
  name              String
  institution       String?
  mask              String?
  type              String?
  currency          String    @default("USD")
  /// Balances in minor units of `currency` (null when the provider does not report them).
  currentMinor      BigInt?   @map("current_minor")
  availableMinor    BigInt?   @map("available_minor")
  balanceAt         DateTime? @map("balance_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([connectionId, externalAccountId])
  @@index([organizationId, companyId])
  @@map("integration_bank_accounts")
}

/// A bank transaction staged from a bank feed (Plaid /transactions/sync), awaiting reconciliation in Finance.
/// amountMinor is signed from the company's point of view: positive = money in, negative = money out.
model IntegrationBankTransaction {
  id                   String    @id @default(uuid(7)) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  companyId            String    @map("company_id") @db.Uuid
  connectionId         String    @map("connection_id") @db.Uuid
  provider             String
  externalAccountId    String    @map("external_account_id")
  externalId           String    @map("external_id")
  bookedOn             DateTime  @map("booked_on") @db.Date
  amountMinor          BigInt    @map("amount_minor")
  currency             String
  description          String
  merchantName         String?   @map("merchant_name")
  category             String?
  pending              Boolean   @default(false)
  /// Set when the provider reported the transaction as removed (kept for the audit trail).
  removedAt            DateTime? @map("removed_at") @db.Timestamptz(3)
  /// Finance transaction this row was reconciled / imported into, when any.
  financeTransactionId String?   @map("finance_transaction_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([organizationId, companyId, bookedOn])
  @@index([connectionId, externalAccountId, bookedOn])
  @@map("integration_bank_transactions")
}
