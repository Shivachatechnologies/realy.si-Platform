// ───────────────────────────── CRM & Sales OS ─────────────────────────────
// Pipelines, deals, generalized sales activities, follow-ups, attachments, custom fields, segments, automation rules,
// sales targets and commission rules. Permissions: sales.read / sales.manage. Leads, LeadFollowUp and LeadActivity live
// in core.prisma; Account and Contact in shared.prisma (all owned by the CRM module). Users (owners) are referenced by
// id only (names are looked up), to keep the User model free of CRM back-relations.

enum CrmStageType {
  OPEN
  WON
  LOST
}

enum CrmDealStatus {
  OPEN
  WON
  LOST
}

enum CrmEntity {
  LEAD
  CONTACT
  ACCOUNT
  DEAL
}

enum CrmFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

enum CrmAssignmentStrategy {
  ROUND_ROBIN
  FIXED
}

enum CrmTargetPeriod {
  MONTH
  QUARTER
}

/// A sales pipeline (a company may run several, e.g. "New business" and "Renewals").
model CrmPipeline {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String
  isDefault      Boolean   @default(false) @map("is_default")
  position       Int       @default(0)
  /// Open deals with no stage change for this many days are flagged stale by the daily job.
  staleDays      Int       @default(30) @map("stale_days")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company         Company             @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  stages          CrmPipelineStage[]
  deals           CrmDeal[]
  commissionRules CrmCommissionRule[]

  @@unique([id, companyId])
  @@index([organizationId, companyId])
  @@map("crm_pipelines")
}

/// An ordered stage of a pipeline with a default win probability; WON/LOST stages close the deal.
model CrmPipelineStage {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  pipelineId     String       @map("pipeline_id") @db.Uuid
  name           String
  position       Int          @default(0)
  probability    Int          @default(10)
  type           CrmStageType @default(OPEN)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company        @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  pipeline CrmPipeline    @relation(fields: [pipelineId, companyId], references: [id, companyId], onDelete: Cascade)
  deals    CrmDeal[]
  rules    CrmStageRule[]

  @@unique([id, companyId])
  @@index([pipelineId, position])
  @@map("crm_pipeline_stages")
}

/// An opportunity: amount in minor units of `currency`, in a pipeline stage, optionally for an account/contact.
model CrmDeal {
  id                   String        @id @default(uuid(7)) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  companyId            String        @map("company_id") @db.Uuid
  name                 String
  accountId            String?       @map("account_id") @db.Uuid
  contactId            String?       @map("contact_id") @db.Uuid
  /// Lead this deal was converted from.
  leadId               String?       @map("lead_id") @db.Uuid
  ownerId              String?       @map("owner_id") @db.Uuid
  pipelineId           String        @map("pipeline_id") @db.Uuid
  stageId              String        @map("stage_id") @db.Uuid
  amountMinor          BigInt        @default(0) @map("amount_minor")
  currency             String        @db.Char(3)
  /// 0–100; null means the stage's probability.
  probability          Int?
  expectedCloseDate    DateTime?     @map("expected_close_date") @db.Date
  status               CrmDealStatus @default(OPEN)
  closedAt             DateTime?     @map("closed_at") @db.Timestamptz(3)
  lostReason           String?       @map("lost_reason")
  source               String?
  campaignCode         String?       @map("campaign_code")
  description          String?
  tags                 String[]      @default([])
  customFields         Json          @default("{}") @map("custom_fields")
  stageEnteredAt       DateTime      @default(now()) @map("stage_entered_at") @db.Timestamptz(3)
  /// Set by the daily job when an open deal sat in its stage longer than the pipeline's staleDays.
  staleSince           DateTime?     @map("stale_since") @db.Timestamptz(3)
  /// Computed win probability 0–100 from history (crm/win-probability.ts, refreshed by crm.deal_win_probability).
  predictedProbability Int?          @map("predicted_probability")
  predictedAt          DateTime?     @map("predicted_at") @db.Timestamptz(3)
  /// The factors behind predictedProbability ({ base, factors: [{ key, delta }] }), shown as "why".
  predictedFactors     Json?         @map("predicted_factors")
  archivedAt           DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdById          String        @map("created_by_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company              @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  account      Account?             @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: NoAction)
  contact      Contact?             @relation(fields: [contactId, companyId], references: [id, companyId], onDelete: NoAction)
  lead         Lead?                @relation(fields: [leadId, companyId], references: [id, companyId], onDelete: NoAction)
  pipeline     CrmPipeline          @relation(fields: [pipelineId, companyId], references: [id, companyId], onDelete: NoAction)
  stage        CrmPipelineStage     @relation(fields: [stageId, companyId], references: [id, companyId], onDelete: NoAction)
  activities   CrmActivity[]
  followUps    CrmFollowUp[]
  attachments  CrmAttachment[]
  stageHistory CrmDealStageChange[]
  proposals    CrmProposal[]
  outreach     CrmOutreachMessage[]
  meetings     CrmMeeting[]

  @@unique([id, companyId])
  @@index([organizationId, companyId, status])
  @@index([pipelineId, stageId])
  @@index([companyId, ownerId])
  @@index([accountId])
  @@index([contactId])
  @@map("crm_deals")
}

/// Every stage move of a deal (sales-cycle and stage analytics).
model CrmDealStageChange {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  fromStageId    String?  @map("from_stage_id") @db.Uuid
  toStageId      String   @map("to_stage_id") @db.Uuid
  changedById    String?  @map("changed_by_id") @db.Uuid
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  deal    CrmDeal @relation(fields: [dealId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([dealId, changedAt])
  @@map("crm_deal_stage_changes")
}

/// A logged call, email, meeting, note or task on a contact, account and/or deal (leads keep LeadActivity).
model CrmActivity {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  type           CrmActivityType
  subject        String?
  summary        String
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz(3)
  durationMin    Int?            @map("duration_min")
  contactId      String?         @map("contact_id") @db.Uuid
  accountId      String?         @map("account_id") @db.Uuid
  dealId         String?         @map("deal_id") @db.Uuid
  createdById    String          @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId, companyId], references: [id, companyId], onDelete: NoAction)
  account Account? @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: NoAction)
  deal    CrmDeal? @relation(fields: [dealId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([organizationId, companyId, occurredAt])
  @@index([contactId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([dealId, occurredAt])
  @@map("crm_activities")
}

/// A follow-up / reminder on a contact, account or deal, assigned to a user (leads keep LeadFollowUp).
model CrmFollowUp {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  dueAt          DateTime         @map("due_at") @db.Timestamptz(3)
  note           String
  priority       FollowUpPriority @default(MEDIUM)
  assigneeId     String?          @map("assignee_id") @db.Uuid
  contactId      String?          @map("contact_id") @db.Uuid
  accountId      String?          @map("account_id") @db.Uuid
  dealId         String?          @map("deal_id") @db.Uuid
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(3)
  /// Last time the reminder job notified the assignee (at most once per day).
  remindedAt     DateTime?        @map("reminded_at") @db.Timestamptz(3)
  createdById    String           @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId, companyId], references: [id, companyId], onDelete: NoAction)
  account Account? @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: NoAction)
  deal    CrmDeal? @relation(fields: [dealId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, completedAt, dueAt])
  @@index([assigneeId, completedAt])
  @@index([dealId])
  @@map("crm_follow_ups")
}

/// A small file (≤ 5 MB) attached to a lead, contact, account or deal, stored in the database.
model CrmAttachment {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String
  mimeType       String   @map("mime_type")
  size           Int
  data           Bytes
  leadId         String?  @map("lead_id") @db.Uuid
  contactId      String?  @map("contact_id") @db.Uuid
  accountId      String?  @map("account_id") @db.Uuid
  dealId         String?  @map("deal_id") @db.Uuid
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  lead    Lead?    @relation(fields: [leadId, companyId], references: [id, companyId], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId, companyId], references: [id, companyId], onDelete: Cascade)
  account Account? @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: Cascade)
  deal    CrmDeal? @relation(fields: [dealId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, leadId])
  @@index([companyId, contactId])
  @@index([companyId, accountId])
  @@index([companyId, dealId])
  @@map("crm_attachments")
}

/// Managed list of lead/deal sources ("Website", "Referral", ...).
model CrmLeadSource {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String
  position       Int       @default(0)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("crm_lead_sources")
}

/// A custom field shown in the forms of one CRM entity; values live in the entity's `customFields` JSON by `key`.
model CrmCustomField {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  entity         CrmEntity
  key            String
  label          String
  type           CrmFieldType @default(TEXT)
  options        String[]     @default([])
  required       Boolean      @default(false)
  position       Int          @default(0)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([companyId, entity, key])
  @@map("crm_custom_fields")
}

/// A saved filter over leads or contacts (the query string of the list page).
model CrmSegment {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  entity         CrmEntity
  name           String
  /// { q, owner, stage, temperature, tag, source, type, qualified } — same keys as the list page filters.
  filters        Json      @default("{}")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([companyId, entity])
  @@map("crm_segments")
}

/// Assigns new unowned leads: round-robin among `ownerIds` (or always the first) when the source/territory match.
model CrmAssignmentRule {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  companyId      String                @map("company_id") @db.Uuid
  name           String
  strategy       CrmAssignmentStrategy @default(ROUND_ROBIN)
  ownerIds       String[]              @map("owner_ids") @db.Uuid
  /// Match leads with this source (case-insensitive); null matches any.
  matchSource    String?               @map("match_source")
  /// Match leads with this territory (case-insensitive); null matches any.
  matchTerritory String?               @map("match_territory")
  /// Create a follow-up for the assigned owner this many days after assignment (null = none).
  followUpDays   Int?                  @map("follow_up_days")
  followUpNote   String?               @map("follow_up_note")
  /// Round-robin cursor: total assignments made by this rule.
  assignedCount  Int                   @default(0) @map("assigned_count")
  position       Int                   @default(0)
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([companyId, active, position])
  @@map("crm_assignment_rules")
}

/// What happens when a deal enters a stage: a follow-up for the owner, a WorkTask, a notification.
model CrmStageRule {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  stageId          String       @map("stage_id") @db.Uuid
  name             String
  createFollowUp   Boolean      @default(false) @map("create_follow_up")
  followUpDays     Int          @default(2) @map("follow_up_days")
  followUpNote     String?      @map("follow_up_note")
  createWorkTask   Boolean      @default(false) @map("create_work_task")
  workTaskTitle    String?      @map("work_task_title")
  /// Sales task (WorkTask linked to the deal) due this many days after the deal enters the stage.
  workTaskDueDays  Int          @default(1) @map("work_task_due_days")
  workTaskPriority WorkPriority @default(MEDIUM) @map("work_task_priority")
  notifyOwner      Boolean      @default(true) @map("notify_owner")
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company          @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  stage   CrmPipelineStage @relation(fields: [stageId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([stageId, active])
  @@map("crm_stage_rules")
}

/// A revenue (and optionally deal-count) target for one owner and one month or quarter.
model CrmSalesTarget {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  ownerId        String          @map("owner_id") @db.Uuid
  period         CrmTargetPeriod @default(MONTH)
  /// First day of the month / quarter.
  periodStart    DateTime        @map("period_start") @db.Date
  amountMinor    BigInt          @map("amount_minor")
  currency       String          @db.Char(3)
  dealsTarget    Int?            @map("deals_target")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([companyId, ownerId, period, periodStart])
  @@map("crm_sales_targets")
}

/// Commission rule: a percentage (basis points) of won amount, optionally per pipeline/owner, with tiers
/// [{ fromMinor, rateBps }] applied progressively to the owner's won amount in the period.
model CrmCommissionRule {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String
  rateBps        Int      @map("rate_bps")
  pipelineId     String?  @map("pipeline_id") @db.Uuid
  ownerId        String?  @map("owner_id") @db.Uuid
  tiers          Json     @default("[]")
  active         Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company      @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  pipeline CrmPipeline? @relation(fields: [pipelineId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, active])
  @@map("crm_commission_rules")
}

// ───────────── Proposals ─────────────

enum CrmProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

/// Per-company counters for human-readable numbers (e.g. proposals "P-0001").
model CrmSequence {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  companyId      String @map("company_id") @db.Uuid
  key            String
  value          Int    @default(0)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([companyId, key])
  @@map("crm_sequences")
}

/// A sales proposal for a deal: sections (light Markdown: paragraphs, **bold**, *italic*, "- " lists, "## " headings),
/// priced line items (totals computed server-side in the deal currency), a public share link and a recorded decision.
model CrmProposal {
  id                     String            @id @default(uuid(7)) @db.Uuid
  organizationId         String            @map("organization_id") @db.Uuid
  companyId              String            @map("company_id") @db.Uuid
  number                 String
  dealId                 String            @map("deal_id") @db.Uuid
  accountId              String?           @map("account_id") @db.Uuid
  contactId              String?           @map("contact_id") @db.Uuid
  ownerId                String?           @map("owner_id") @db.Uuid
  title                  String
  intro                  String            @default("")
  scope                  String            @default("")
  timeline               String            @default("")
  terms                  String            @default("")
  currency               String            @db.Char(3)
  subtotalMinor          BigInt            @default(0) @map("subtotal_minor")
  discountMinor          BigInt            @default(0) @map("discount_minor")
  taxMinor               BigInt            @default(0) @map("tax_minor")
  totalMinor             BigInt            @default(0) @map("total_minor")
  validUntil             DateTime?         @map("valid_until") @db.Date
  status                 CrmProposalStatus @default(DRAFT)
  /// Current revision number; earlier sent versions are kept in CrmProposalRevision.
  version                Int               @default(1)
  /// Unguessable token of the public share link /p/<token>.
  shareToken             String            @unique @map("share_token")
  sentAt                 DateTime?         @map("sent_at") @db.Timestamptz(3)
  sentTo                 String?           @map("sent_to")
  viewedAt               DateTime?         @map("viewed_at") @db.Timestamptz(3)
  viewCount              Int               @default(0) @map("view_count")
  decidedAt              DateTime?         @map("decided_at") @db.Timestamptz(3)
  decisionName           String?           @map("decision_name")
  decisionNote           String?           @map("decision_note")
  decisionIp             String?           @map("decision_ip")
  decisionUserAgent      String?           @map("decision_user_agent")
  /// On acceptance, also create a finance estimate draft (when the deal has an account).
  createEstimateOnAccept Boolean           @default(false) @map("create_estimate_on_accept")
  /// Finance estimate created from this proposal (finance module's Estimate id).
  estimateId             String?           @map("estimate_id") @db.Uuid
  archivedAt             DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdById            String            @map("created_by_id") @db.Uuid
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company               @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  deal      CrmDeal               @relation(fields: [dealId, companyId], references: [id, companyId], onDelete: Cascade)
  account   Account?              @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: NoAction)
  contact   Contact?              @relation(fields: [contactId, companyId], references: [id, companyId], onDelete: NoAction)
  lines     CrmProposalLine[]
  revisions CrmProposalRevision[]
  sends     CrmProposalSend[]

  @@unique([id, companyId])
  @@unique([companyId, number])
  @@index([organizationId, companyId, status])
  @@index([dealId])
  @@index([contactId])
  @@index([accountId])
  @@map("crm_proposals")
}

/// A priced line of a proposal (quantity in thousandths, discount and tax in basis points; totals computed server-side).
model CrmProposalLine {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  proposalId     String   @map("proposal_id") @db.Uuid
  position       Int
  description    String
  quantityMilli  Int      @map("quantity_milli")
  unitPriceMinor BigInt   @map("unit_price_minor")
  discountBps    Int      @default(0) @map("discount_bps")
  taxBps         Int      @default(0) @map("tax_bps")
  netMinor       BigInt   @map("net_minor")
  taxMinor       BigInt   @map("tax_minor")
  totalMinor     BigInt   @map("total_minor")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company     @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  proposal CrmProposal @relation(fields: [proposalId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([proposalId, position])
  @@map("crm_proposal_lines")
}

/// Snapshot of an earlier version of a proposal (taken when a sent proposal is edited).
model CrmProposalRevision {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  proposalId     String   @map("proposal_id") @db.Uuid
  version        Int
  /// { title, intro, scope, timeline, terms, validUntil, currency, lines[], totals, status, sentAt }
  snapshot       Json
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company     @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  proposal CrmProposal @relation(fields: [proposalId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([proposalId, version])
  @@map("crm_proposal_revisions")
}

/// Every email delivery of a proposal's share link (only rows the provider accepted).
model CrmProposalSend {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  proposalId        String   @map("proposal_id") @db.Uuid
  version           Int
  toEmail           String   @map("to_email")
  subject           String
  body              String
  providerMessageId String?  @map("provider_message_id")
  sentById          String?  @map("sent_by_id") @db.Uuid
  sentAt            DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)

  company  Company     @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  proposal CrmProposal @relation(fields: [proposalId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, toEmail])
  @@index([proposalId, sentAt])
  @@map("crm_proposal_sends")
}

/// Per-owner sales capacity settings (team management): limits used by assignment rules and the team page.
model CrmSalesRep {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  ownerId        String   @map("owner_id") @db.Uuid
  /// Maximum open deals; null = unlimited.
  maxOpenDeals   Int?     @map("max_open_deals")
  /// Maximum open (unconverted, unarchived) leads; assignment rules skip owners at this limit. null = unlimited.
  maxOpenLeads   Int?     @map("max_open_leads")
  /// Excluded from automatic assignment (e.g. on leave).
  available      Boolean  @default(true)
  role           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([companyId, ownerId])
  @@map("crm_sales_reps")
}

/// Saved progress of a guided "Start here" journey (Sales OS "Start selling", Finance OS beginner flows), one row per
/// company and flow key, so a journey can be resumed by anyone on the team.
model GuidedFlowProgress {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  /// e.g. "sales_start", "finance_income".
  flow           String
  step           Int       @default(0)
  /// Answers and ids of records/AI tasks created along the way.
  data           Json      @default("{}")
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  dismissedAt    DateTime? @map("dismissed_at") @db.Timestamptz(3)
  updatedById    String?   @map("updated_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([companyId, flow])
  @@map("guided_flow_progress")
}

// ───────────── Revenue engine: discovery, intel, outreach, cadences, meetings ─────────────
// Leads (core.prisma) and contacts (shared.prisma) are referenced by id only (validated inside the company by the
// services) so these models add no back-relations outside this file except Company.

enum CrmProspectStatus {
  NEW
  ADDED
  DISMISSED
}

/// A lead-discovery run: a plain-language description of the ideal customer sent to a connected research provider.
model CrmProspectSearch {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  query          String
  /// Who we sell to, as typed by the user (kept for re-runs).
  audience       String?
  /// Provider that answered (tavily / exa / serpapi).
  provider       String?
  resultCount    Int      @default(0) @map("result_count")
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company       @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  prospects CrmProspect[]

  @@unique([id, companyId])
  @@index([organizationId, companyId, createdAt])
  @@map("crm_prospect_searches")
}

/// One real web result of a discovery run (title, URL, snippet exactly as the provider returned them).
model CrmProspect {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  searchId       String            @map("search_id") @db.Uuid
  title          String
  url            String
  domain         String?
  snippet        String            @default("")
  publishedAt    String?           @map("published_at")
  status         CrmProspectStatus @default(NEW)
  /// Lead created from this result.
  leadId         String?           @map("lead_id") @db.Uuid
  decidedById    String?           @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?         @map("decided_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company           @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  search  CrmProspectSearch @relation(fields: [searchId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([searchId, url])
  @@index([companyId, status])
  @@index([companyId, domain])
  @@map("crm_prospects")
}

enum CrmIntelKind {
  ENRICHMENT
  QUALIFICATION
}

/// Research about a lead or account: provider-backed enrichment (web sources) or an AI qualification with reasons.
/// Every fact keeps the source it came from; nothing is stored when no provider answered.
model CrmIntel {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  kind           CrmIntelKind
  leadId         String?      @map("lead_id") @db.Uuid
  accountId      String?      @map("account_id") @db.Uuid
  summary        String       @default("")
  /// ENRICHMENT: { facts: [{ label, value, sourceUrl }] }. QUALIFICATION: { verdict, fit, reasons[], missing[], bant }.
  data           Json         @default("{}")
  /// [{ title, url, snippet }]
  sources        Json         @default("[]")
  /// 0–100 AI fit score (QUALIFICATION only).
  fitScore       Int?         @map("fit_score")
  provider       String?
  model          String?
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([companyId, leadId, kind, createdAt])
  @@index([companyId, accountId, kind, createdAt])
  @@map("crm_intel")
}

enum CrmOutreachStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  FAILED
  CANCELLED
}

/// A personal sales email: drafted (by a person or AI), approved by a person, then sent through the company's connected
/// mailbox (Gmail / Outlook) or SendGrid. SENT only when the provider accepted it.
model CrmOutreachMessage {
  id                String            @id @default(uuid(7)) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  leadId            String?           @map("lead_id") @db.Uuid
  contactId         String?           @map("contact_id") @db.Uuid
  dealId            String?           @map("deal_id") @db.Uuid
  enrollmentId      String?           @map("enrollment_id") @db.Uuid
  stepPosition      Int?              @map("step_position")
  toEmail           String            @map("to_email")
  toName            String?           @map("to_name")
  subject           String
  body              String
  status            CrmOutreachStatus @default(DRAFT)
  /// mailbox:gmail / mailbox:outlook / sendgrid
  channel           String?
  providerMessageId String?           @map("provider_message_id")
  error             String?
  /// AI provider + model that drafted the text (null = written by a person).
  aiProvider        String?           @map("ai_provider")
  /// Prospecting autopilot that created this email (first touch or one of its follow-ups); counts toward its send cap.
  autopilotId       String?           @map("autopilot_id") @db.Uuid
  createdById       String?           @map("created_by_id") @db.Uuid
  approvedById      String?           @map("approved_by_id") @db.Uuid
  approvedAt        DateTime?         @map("approved_at") @db.Timestamptz(3)
  sentAt            DateTime?         @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company               @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  deal       CrmDeal?              @relation(fields: [dealId, companyId], references: [id, companyId], onDelete: Cascade)
  enrollment CrmCadenceEnrollment? @relation(fields: [enrollmentId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([id, companyId])
  @@index([organizationId, companyId, status])
  @@index([companyId, leadId])
  @@index([companyId, contactId])
  @@index([companyId, toEmail])
  @@index([autopilotId, status, sentAt])
  @@map("crm_outreach_messages")
}

enum CrmCadenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CrmCadenceStepKind {
  EMAIL
  TASK
}

/// What a reply to outreach means (crm/replies.ts); drives the follow-up action.
enum CrmReplyClass {
  INTERESTED
  NOT_INTERESTED
  OUT_OF_OFFICE
  UNSUBSCRIBE
  REFERRAL
  QUESTION
  OTHER
}

enum CrmEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REPLIED
  STOPPED
  FAILED
}

/// An automated follow-up sequence ("cadence"): timed email/task steps that stop as soon as the person replies.
model CrmCadence {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  name           String
  description    String?
  status         CrmCadenceStatus @default(DRAFT)
  /// false: every email step waits in the approval queue. true: a person approved the step texts when activating, so
  /// steps are sent on schedule without further review.
  autoSend       Boolean          @default(false) @map("auto_send")
  stopOnReply    Boolean          @default(true) @map("stop_on_reply")
  activatedById  String?          @map("activated_by_id") @db.Uuid
  activatedAt    DateTime?        @map("activated_at") @db.Timestamptz(3)
  createdById    String           @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company                @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  steps       CrmCadenceStep[]
  enrollments CrmCadenceEnrollment[]

  @@unique([id, companyId])
  @@index([organizationId, companyId, status])
  @@map("crm_cadences")
}

/// A step of a cadence. Subject/body may use {{firstName}}, {{name}}, {{company}} and {{sender}}.
model CrmCadenceStep {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  companyId      String             @map("company_id") @db.Uuid
  cadenceId      String             @map("cadence_id") @db.Uuid
  position       Int
  kind           CrmCadenceStepKind @default(EMAIL)
  /// Days after the previous step (or after enrolment for the first step).
  delayDays      Int                @default(2) @map("delay_days")
  subject        String             @default("")
  body           String
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company    @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  cadence CrmCadence @relation(fields: [cadenceId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([cadenceId, position])
  @@map("crm_cadence_steps")
}

/// One person (lead or contact) going through a cadence.
model CrmCadenceEnrollment {
  id                String              @id @default(uuid(7)) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  companyId         String              @map("company_id") @db.Uuid
  cadenceId         String              @map("cadence_id") @db.Uuid
  leadId            String?             @map("lead_id") @db.Uuid
  contactId         String?             @map("contact_id") @db.Uuid
  toEmail           String              @map("to_email")
  name              String
  status            CrmEnrollmentStatus @default(ACTIVE)
  /// Position of the next step to run.
  nextStep          Int                 @default(0) @map("next_step")
  nextRunAt         DateTime?           @map("next_run_at") @db.Timestamptz(3)
  lastStepAt        DateTime?           @map("last_step_at") @db.Timestamptz(3)
  stoppedReason     String?             @map("stopped_reason")
  ownerId           String?             @map("owner_id") @db.Uuid
  enrolledById      String              @map("enrolled_by_id") @db.Uuid
  /// Last reply's classification (crm/replies.ts); replies after replyClassifiedAt are classified again.
  replyClass        CrmReplyClass?      @map("reply_class")
  replyClassifiedAt DateTime?           @map("reply_classified_at") @db.Timestamptz(3)
  /// Out of office: the sequence resumes at this time.
  replyResumeAt     DateTime?           @map("reply_resume_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company              @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  cadence  CrmCadence           @relation(fields: [cadenceId, companyId], references: [id, companyId], onDelete: Cascade)
  messages CrmOutreachMessage[]

  @@unique([id, companyId])
  @@unique([cadenceId, toEmail])
  @@index([status, nextRunAt])
  @@index([companyId, leadId])
  @@index([companyId, contactId])
  @@map("crm_cadence_enrollments")
}

enum CrmMeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// A sales meeting with a customer. Pushed to the connected Google / Outlook calendar (with the customer as attendee)
/// only when one is connected; otherwise the calendar file (.ics) is offered and inviteSentAt stays empty.
model CrmMeeting {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  title            String
  agenda           String?
  location         String?
  startsAt         DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime         @map("ends_at") @db.Timestamptz(3)
  leadId           String?          @map("lead_id") @db.Uuid
  contactId        String?          @map("contact_id") @db.Uuid
  accountId        String?          @map("account_id") @db.Uuid
  dealId           String?          @map("deal_id") @db.Uuid
  attendeeEmail    String?          @map("attendee_email")
  attendeeName     String?          @map("attendee_name")
  status           CrmMeetingStatus @default(SCHEDULED)
  calendarProvider String?          @map("calendar_provider")
  externalId       String?          @map("external_id")
  inviteSentAt     DateTime?        @map("invite_sent_at") @db.Timestamptz(3)
  calendarError    String?          @map("calendar_error")
  outcome          String?
  organizerId      String           @map("organizer_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  deal    CrmDeal? @relation(fields: [dealId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([organizationId, companyId, startsAt])
  @@index([companyId, leadId])
  @@index([companyId, contactId])
  @@map("crm_meetings")
}

// ───────────── Prospecting autopilot (AI SDR): decision makers, verified emails, suppression ─────────────

enum CrmAutopilotStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// What the autopilot may do with the first email: keep a draft, queue it for a person's approval, or send it within caps.
enum CrmAutopilotAutonomy {
  DRAFT_ONLY
  REVIEW
  AUTO_SEND
}

/// A prospecting autopilot for one ideal-customer profile: finds companies, their decision makers and verified emails,
/// creates leads (with the consent basis) and writes a personalized first email + follow-up sequence, within daily
/// caps. Sending automatically requires a person to approve auto-send when activating (activatedById).
model CrmProspectingAutopilot {
  id                 String               @id @default(uuid(7)) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  companyId          String               @map("company_id") @db.Uuid
  name               String
  status             CrmAutopilotStatus   @default(DRAFT)
  /// The ideal customer in plain words ("independent bakeries that offer catering").
  audience           String
  /// What we offer and why it matters to them (grounding for the AI-written first email).
  pitch              String               @default("")
  regions            String[]             @default([])
  /// Job titles to reach ("Owner", "Head of Operations").
  roles              String[]             @default([])
  /// Canonical seniorities (owner, founder, c_suite, partner, vp, head, director, manager, senior, entry).
  seniorities        String[]             @default([])
  /// Domains or words to skip (competitors, existing customers, industries).
  exclusions         String[]             @default([])
  /// Specific company domains to work through first (optional list from the founder).
  targetDomains      String[]             @default([]) @map("target_domains")
  /// New people to find per day.
  dailyQuota         Int                  @default(10) @map("daily_quota")
  /// Most emails (first touches + follow-ups) sent per day.
  dailySendCap       Int                  @default(20) @map("daily_send_cap")
  peoplePerCompany   Int                  @default(2) @map("people_per_company")
  autonomy           CrmAutopilotAutonomy @default(REVIEW)
  /// Explicit opt-in to contact addresses that could not be verified (never by default), with its own lower cap.
  allowUnverified    Boolean              @default(false) @map("allow_unverified")
  unverifiedDailyCap Int                  @default(3) @map("unverified_daily_cap")
  /// Lawful basis recorded on every lead it creates (e.g. legitimate_interest).
  consentBasis       String               @default("legitimate_interest") @map("consent_basis")
  consentNote        String               @default("") @map("consent_note")
  /// Contact-data provider order (apollo, hunter, pdl); empty = default order.
  providerOrder      String[]             @default([]) @map("provider_order")
  /// Founder-written first email used when no AI text provider is connected ({{firstName}}, {{company}}, {{sender}}).
  firstSubject       String               @default("") @map("first_subject")
  firstBody          String               @default("") @map("first_body")
  /// Sentence before the unsubscribe link added to every email of this autopilot (in the founder's language).
  unsubscribeLine    String               @default("") @map("unsubscribe_line")
  /// Follow-up sequence created for this autopilot.
  cadenceId          String?              @map("cadence_id") @db.Uuid
  ownerId            String?              @map("owner_id") @db.Uuid
  activatedById      String?              @map("activated_by_id") @db.Uuid
  activatedAt        DateTime?            @map("activated_at") @db.Timestamptz(3)
  lastRunAt          DateTime?            @map("last_run_at") @db.Timestamptz(3)
  nextRunAt          DateTime?            @map("next_run_at") @db.Timestamptz(3)
  lastError          String?              @map("last_error")
  createdById        String               @map("created_by_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company               @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  companies CrmAutopilotCompany[]
  people    CrmProspectPerson[]
  runs      CrmAutopilotRun[]

  @@unique([id, companyId])
  @@index([organizationId, companyId, status])
  @@index([status, nextRunAt])
  @@map("crm_prospecting_autopilots")
}

enum CrmAutopilotCompanyStatus {
  PENDING
  DONE
  NO_PEOPLE
  EXCLUDED
  FAILED
}

/// A company (by domain) the autopilot found or was given, and what came of it.
model CrmAutopilotCompany {
  id             String                    @id @default(uuid(7)) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  companyId      String                    @map("company_id") @db.Uuid
  autopilotId    String                    @map("autopilot_id") @db.Uuid
  domain         String
  name           String
  /// Where it came from: web research URL or "manual".
  sourceUrl      String?                   @map("source_url")
  status         CrmAutopilotCompanyStatus @default(PENDING)
  peopleFound    Int                       @default(0) @map("people_found")
  error          String?
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company                 @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  autopilot CrmProspectingAutopilot @relation(fields: [autopilotId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([autopilotId, domain])
  @@index([autopilotId, status])
  @@map("crm_autopilot_companies")
}

/// How an email address was checked. VERIFIED = a provider confirmed it deliverable; RISKY = accept-all / unknown
/// server; UNVERIFIED = found but not confirmed; INVALID = undeliverable; NONE = no address found.
enum CrmEmailVerification {
  VERIFIED
  RISKY
  UNVERIFIED
  INVALID
  NONE
}

enum CrmProspectPersonStatus {
  FOUND
  READY
  SKIPPED
  CONTACTED
  REPLIED
  MEETING
  BOUNCED
  UNSUBSCRIBED
  STOPPED
}

/// A decision maker found by a contact-data provider. Name, title and email are stored exactly as the provider returned
/// them, with the verification result and its source; nothing is guessed.
model CrmProspectPerson {
  id                String                  @id @default(uuid(7)) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  companyId         String                  @map("company_id") @db.Uuid
  autopilotId       String                  @map("autopilot_id") @db.Uuid
  domain            String
  companyName       String?                 @map("company_name")
  firstName         String?                 @map("first_name")
  lastName          String?                 @map("last_name")
  fullName          String                  @map("full_name")
  title             String?
  seniority         String?
  linkedinUrl       String?                 @map("linkedin_url")
  location          String?
  /// Provider that found the person (apollo / hunter / pdl) and its id there.
  sourceProvider    String                  @map("source_provider")
  externalId        String?                 @map("external_id")
  email             String?
  emailNormalized   String?                 @map("email_normalized")
  emailStatus       CrmEmailVerification    @default(NONE) @map("email_status")
  /// Provider that supplied the address, and the one that verified it.
  emailSource       String?                 @map("email_source")
  verifiedBy        String?                 @map("verified_by")
  verifiedAt        DateTime?               @map("verified_at") @db.Timestamptz(3)
  /// Provider verdict as returned (status, score, accept_all...).
  verification      Json                    @default("{}")
  /// Lawful basis for contacting this person, copied from the autopilot when the lead was created.
  consentBasis      String?                 @map("consent_basis")
  consentNote       String?                 @map("consent_note")
  status            CrmProspectPersonStatus @default(FOUND)
  skipReason        String?                 @map("skip_reason")
  leadId            String?                 @map("lead_id") @db.Uuid
  firstMessageId    String?                 @map("first_message_id") @db.Uuid
  enrollmentId      String?                 @map("enrollment_id") @db.Uuid
  contactedAt       DateTime?               @map("contacted_at") @db.Timestamptz(3)
  repliedAt         DateTime?               @map("replied_at") @db.Timestamptz(3)
  meetingAt         DateTime?               @map("meeting_at") @db.Timestamptz(3)
  bouncedAt         DateTime?               @map("bounced_at") @db.Timestamptz(3)
  unsubscribedAt    DateTime?               @map("unsubscribed_at") @db.Timestamptz(3)
  /// Last reply's classification (crm/replies.ts); replies after replyClassifiedAt are classified again.
  replyClass        CrmReplyClass?          @map("reply_class")
  replyClassifiedAt DateTime?               @map("reply_classified_at") @db.Timestamptz(3)
  /// Out of office: the sequence resumes at this time.
  replyResumeAt     DateTime?               @map("reply_resume_at") @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company                 @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  autopilot CrmProspectingAutopilot @relation(fields: [autopilotId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@unique([autopilotId, domain, fullName])
  @@index([companyId, emailNormalized])
  @@index([autopilotId, status])
  @@index([autopilotId, createdAt])
  @@index([companyId, leadId])
  @@map("crm_prospect_people")
}

/// One autopilot run (worker job or "Run now"): what it found, verified, drafted and sent — the honest log.
model CrmAutopilotRun {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  autopilotId    String    @map("autopilot_id") @db.Uuid
  /// ok / partial / skipped / failed
  outcome        String    @default("ok")
  companies      Int       @default(0)
  found          Int       @default(0)
  verified       Int       @default(0)
  leads          Int       @default(0)
  drafted        Int       @default(0)
  sent           Int       @default(0)
  stopped        Int       @default(0)
  /// Plain notes: missing providers, caps reached, provider errors.
  notes          Json      @default("[]")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)

  company   Company                 @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  autopilot CrmProspectingAutopilot @relation(fields: [autopilotId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([autopilotId, startedAt])
  @@map("crm_autopilot_runs")
}

enum CrmSuppressionKind {
  EMAIL
  DOMAIN
}

/// Company-wide do-not-contact list for sales outreach (an email address or a whole domain). Checked before every CRM
/// email together with the marketing unsubscribe list; bounces and unsubscribes are added automatically.
model CrmSuppression {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  companyId      String             @map("company_id") @db.Uuid
  kind           CrmSuppressionKind
  /// Lower-cased email address or domain.
  value          String
  /// unsubscribed / bounced / complaint / manual / customer / competitor / do_not_contact
  reason         String
  /// manual / autopilot / unsubscribe_link / bounce
  source         String             @default("manual")
  note           String?
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([companyId, kind, value])
  @@index([organizationId, companyId, createdAt])
  @@map("crm_suppressions")
}
