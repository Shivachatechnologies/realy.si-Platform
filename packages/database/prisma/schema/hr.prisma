// HR & People OS (src/server/modules/hr). Organization structure (Department, Team, Employee) lives in shared.prisma.
// Every row is tenant-scoped (organizationId + companyId) and children reference parents with (id, companyId).

// ─── Employee records ───────────────────────────────────────────────────────────────────────────────────────────────

/// Job title catalog (designations) employees can be assigned.
model HrDesignation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String
  /// Seniority level label, e.g. "L3" or "Senior".
  level          String?
  description    String?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employees Employee[] @relation("EmployeeDesignation")

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@map("hr_designations")
}

/// Employee history log: creation, status (lifecycle) changes, job changes.
model HrEmployeeEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  /// created | status | job | manager | user_link | document
  kind           String
  fromValue      String?  @map("from_value")
  toValue        String?  @map("to_value")
  note           String?
  actorId        String?  @map("actor_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@index([companyId, kind, createdAt])
  @@map("hr_employee_events")
}

/// A file attached to an employee (contract, ID, certificate...). Stored in the database, ≤ 5 MB.
model HrDocument {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  name           String
  category       String   @default("other")
  filename       String
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  content        Bytes
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([employeeId])
  @@map("hr_documents")
}

// ─── Recruiting (ATS) ───────────────────────────────────────────────────────────────────────────────────────────────

enum HrJobStatus {
  DRAFT
  OPEN
  CLOSED
}

model HrJob {
  id              String         @id @default(uuid(7)) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  title           String
  departmentId    String?        @map("department_id") @db.Uuid
  location        String?
  employmentType  EmploymentType @default(FULL_TIME) @map("employment_type")
  remote          Boolean        @default(false)
  description     String         @default("")
  status          HrJobStatus    @default(DRAFT)
  openings        Int            @default(1)
  salaryMinMinor  BigInt?        @map("salary_min_minor")
  salaryMaxMinor  BigInt?        @map("salary_max_minor")
  currency        String         @db.Char(3)
  hiringManagerId String?        @map("hiring_manager_id") @db.Uuid
  publishedAt     DateTime?      @map("published_at") @db.Timestamptz(3)
  closedAt        DateTime?      @map("closed_at") @db.Timestamptz(3)
  createdById     String         @map("created_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company        Company           @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  department     Department?       @relation("HrJobDepartment", fields: [departmentId, companyId], references: [id, companyId], onDelete: NoAction)
  hiringManager  Employee?         @relation("HrJobHiringManager", fields: [hiringManagerId, companyId], references: [id, companyId], onDelete: NoAction)
  candidates     HrCandidate[]
  journey        HrHiringJourney?
  headcountPlans HrHeadcountPlan[]

  @@unique([id, companyId])
  @@index([organizationId, companyId, status])
  @@map("hr_jobs")
}

enum HrCandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model HrCandidate {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  jobId          String           @map("job_id") @db.Uuid
  firstName      String           @map("first_name")
  lastName       String?          @map("last_name")
  email          String
  phone          String?
  linkedinUrl    String?          @map("linkedin_url")
  coverLetter    String?          @map("cover_letter")
  /// careers | referral | manual | agency | other
  source         String           @default("manual")
  stage          HrCandidateStage @default(APPLIED)
  /// Recruiter's own rating 1–5.
  rating         Int?
  resumeFilename String?          @map("resume_filename")
  resumeBytes    Bytes?           @map("resume_bytes")
  resumeSize     Int?             @map("resume_size")
  resumeText     String?          @map("resume_text")
  /// AI assessment written by the score_candidate tool (0–100) after a person approved it.
  aiScore        Int?             @map("ai_score")
  aiSummary      String?          @map("ai_summary")
  aiScoredAt     DateTime?        @map("ai_scored_at") @db.Timestamptz(3)
  rejectedReason String?          @map("rejected_reason")
  decisionNote   String?          @map("decision_note")
  hiredAt        DateTime?        @map("hired_at") @db.Timestamptz(3)
  employeeId     String?          @map("employee_id") @db.Uuid
  appliedAt      DateTime         @default(now()) @map("applied_at") @db.Timestamptz(3)
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company           @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  job        HrJob             @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Cascade)
  employee   Employee?         @relation("HrCandidateEmployee", fields: [employeeId, companyId], references: [id, companyId], onDelete: NoAction)
  notes      HrCandidateNote[]
  interviews HrInterview[]
  scorecards HrScorecard[]
  offers     HrOffer[]

  @@unique([id, companyId])
  @@index([organizationId, companyId, stage])
  @@index([jobId, stage])
  @@index([companyId, email])
  @@map("hr_candidates")
}

model HrCandidateNote {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  candidateId    String   @map("candidate_id") @db.Uuid
  body           String
  authorId       String?  @map("author_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company     @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  candidate HrCandidate @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([candidateId, createdAt])
  @@map("hr_candidate_notes")
}

enum HrInterviewType {
  PHONE
  VIDEO
  ONSITE
  TECHNICAL
  PANEL
}

enum HrInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model HrInterview {
  id               String            @id @default(uuid(7)) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  candidateId      String            @map("candidate_id") @db.Uuid
  type             HrInterviewType   @default(VIDEO)
  status           HrInterviewStatus @default(SCHEDULED)
  scheduledAt      DateTime          @map("scheduled_at") @db.Timestamptz(3)
  durationMin      Int               @default(45) @map("duration_min")
  location         String?
  /// Employee ids of the interviewers (validated against the company).
  interviewerIds   String[]          @default([]) @map("interviewer_ids") @db.Uuid
  notes            String?
  /// Calendar the interview was pushed to ("google_calendar" | "outlook_calendar"); null = not synced (manual).
  calendarProvider String?           @map("calendar_provider")
  calendarEventId  String?           @map("calendar_event_id")
  calendarSyncedAt DateTime?         @map("calendar_synced_at") @db.Timestamptz(3)
  /// Last provider error when the push failed (shown to HR; nothing is claimed as synced).
  calendarError    String?           @map("calendar_error")
  createdById      String            @map("created_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company       @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  candidate  HrCandidate   @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Cascade)
  scorecards HrScorecard[]

  @@unique([id, companyId])
  @@index([candidateId, scheduledAt])
  @@index([companyId, scheduledAt])
  @@map("hr_interviews")
}

enum HrRecommendation {
  STRONG_NO
  NO
  YES
  STRONG_YES
}

model HrScorecard {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  candidateId    String           @map("candidate_id") @db.Uuid
  interviewId    String?          @map("interview_id") @db.Uuid
  /// { "<criterion>": 1..5 }
  ratings        Json             @default("{}")
  recommendation HrRecommendation
  comments       String?
  authorId       String?          @map("author_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company      @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  candidate HrCandidate  @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Cascade)
  interview HrInterview? @relation(fields: [interviewId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([candidateId])
  @@map("hr_scorecards")
}

enum HrOfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

model HrOffer {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  candidateId    String        @map("candidate_id") @db.Uuid
  title          String
  /// Yearly salary in minor units.
  salaryMinor    BigInt        @map("salary_minor")
  currency       String        @db.Char(3)
  startDate      DateTime?     @map("start_date") @db.Date
  status         HrOfferStatus @default(DRAFT)
  terms          String?
  sentAt         DateTime?     @map("sent_at") @db.Timestamptz(3)
  respondedAt    DateTime?     @map("responded_at") @db.Timestamptz(3)
  createdById    String        @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company     @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  candidate HrCandidate @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([candidateId])
  @@map("hr_offers")
}

// ─── Onboarding / offboarding & assets ─────────────────────────────────────────────────────────────────────────────

enum HrChecklistKind {
  ONBOARDING
  OFFBOARDING
}

enum HrChecklistCategory {
  GENERAL
  ACCESS
  DOCUMENT
  EQUIPMENT
  TRAINING
}

enum HrOwnerRole {
  HR
  MANAGER
  EMPLOYEE
  IT
}

model HrChecklistTemplate {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  name           String
  kind           HrChecklistKind @default(ONBOARDING)
  description    String?
  isDefault      Boolean         @default(false) @map("is_default")
  archivedAt     DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company                   @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  tasks     HrChecklistTemplateTask[]
  instances HrChecklist[]

  @@unique([id, companyId])
  @@index([companyId, kind])
  @@map("hr_checklist_templates")
}

model HrChecklistTemplateTask {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  companyId      String              @map("company_id") @db.Uuid
  templateId     String              @map("template_id") @db.Uuid
  title          String
  description    String?
  category       HrChecklistCategory @default(GENERAL)
  ownerRole      HrOwnerRole         @default(HR) @map("owner_role")
  /// Due this many days after the start (negative = before).
  dueDays        Int                 @default(0) @map("due_days")
  position       Int                 @default(0)

  company  Company             @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  template HrChecklistTemplate @relation(fields: [templateId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([templateId, position])
  @@map("hr_checklist_template_tasks")
}

enum HrChecklistStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// An onboarding or offboarding run for one employee.
model HrChecklist {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  employeeId     String            @map("employee_id") @db.Uuid
  templateId     String?           @map("template_id") @db.Uuid
  kind           HrChecklistKind
  status         HrChecklistStatus @default(IN_PROGRESS)
  startDate      DateTime          @map("start_date") @db.Date
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdById    String            @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company              @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee Employee             @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  template HrChecklistTemplate? @relation(fields: [templateId, companyId], references: [id, companyId], onDelete: NoAction)
  items    HrChecklistItem[]

  @@unique([id, companyId])
  @@index([organizationId, companyId, status])
  @@index([employeeId])
  @@map("hr_checklists")
}

model HrChecklistItem {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  companyId      String              @map("company_id") @db.Uuid
  checklistId    String              @map("checklist_id") @db.Uuid
  title          String
  description    String?
  category       HrChecklistCategory @default(GENERAL)
  ownerRole      HrOwnerRole         @default(HR) @map("owner_role")
  dueDate        DateTime?           @map("due_date") @db.Date
  position       Int                 @default(0)
  /// The WorkTask created for this step (Work module, sourceType "onboarding").
  workTaskId     String?             @map("work_task_id") @db.Uuid
  completedAt    DateTime?           @map("completed_at") @db.Timestamptz(3)
  completedById  String?             @map("completed_by_id") @db.Uuid

  company   Company     @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  checklist HrChecklist @relation(fields: [checklistId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([checklistId, position])
  @@index([workTaskId])
  @@map("hr_checklist_items")
}

enum HrAssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

model HrAsset {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  name           String
  /// Inventory tag, unique per company.
  tag            String
  category       String        @default("laptop")
  serialNumber   String?       @map("serial_number")
  status         HrAssetStatus @default(AVAILABLE)
  purchaseDate   DateTime?     @map("purchase_date") @db.Date
  valueMinor     BigInt?       @map("value_minor")
  currency       String?       @db.Char(3)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company             @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignments HrAssetAssignment[]

  @@unique([id, companyId])
  @@unique([companyId, tag])
  @@index([companyId, status])
  @@map("hr_assets")
}

model HrAssetAssignment {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  returnedAt     DateTime? @map("returned_at") @db.Timestamptz(3)
  notes          String?
  assignedById   String?   @map("assigned_by_id") @db.Uuid

  company  Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  asset    HrAsset  @relation(fields: [assetId, companyId], references: [id, companyId], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([assetId, assignedAt])
  @@index([employeeId])
  @@map("hr_asset_assignments")
}

// ─── Performance ────────────────────────────────────────────────────────────────────────────────────────────────────

model HrKpi {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  name           String
  unit           String?
  /// Free-form period label, e.g. "2026-Q4".
  period         String
  target         Float
  actual         Float?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([employeeId, period])
  @@map("hr_kpis")
}

enum HrGoalStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  COMPLETED
  CANCELLED
}

model HrGoal {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  employeeId     String       @map("employee_id") @db.Uuid
  title          String
  description    String?
  /// Optional company Objective (core.prisma) this goal supports; validated within the company.
  objectiveId    String?      @map("objective_id") @db.Uuid
  dueDate        DateTime?    @map("due_date") @db.Date
  progress       Int          @default(0)
  status         HrGoalStatus @default(NOT_STARTED)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([employeeId, status])
  @@map("hr_goals")
}

enum HrCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model HrReviewCycle {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  name           String
  startDate      DateTime      @map("start_date") @db.Date
  endDate        DateTime      @map("end_date") @db.Date
  status         HrCycleStatus @default(DRAFT)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company    @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  reviews HrReview[]

  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("hr_review_cycles")
}

enum HrReviewStatus {
  PENDING_SELF
  PENDING_MANAGER
  COMPLETED
}

model HrReview {
  id              String         @id @default(uuid(7)) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  cycleId         String         @map("cycle_id") @db.Uuid
  employeeId      String         @map("employee_id") @db.Uuid
  /// The reviewing manager (employee) at the time the review was created.
  reviewerId      String?        @map("reviewer_id") @db.Uuid
  status          HrReviewStatus @default(PENDING_SELF)
  selfRating      Int?           @map("self_rating")
  selfComments    String?        @map("self_comments")
  managerRating   Int?           @map("manager_rating")
  managerComments String?        @map("manager_comments")
  selfSubmittedAt DateTime?      @map("self_submitted_at") @db.Timestamptz(3)
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company       @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  cycle    HrReviewCycle @relation(fields: [cycleId, companyId], references: [id, companyId], onDelete: Cascade)
  employee Employee      @relation("HrReviewEmployee", fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  reviewer Employee?     @relation("HrReviewReviewer", fields: [reviewerId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([id, companyId])
  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@map("hr_reviews")
}

enum HrFeedbackKind {
  PRAISE
  CONSTRUCTIVE
  NOTE
}

model HrFeedback {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  employeeId     String         @map("employee_id") @db.Uuid
  kind           HrFeedbackKind @default(PRAISE)
  body           String
  /// Private feedback is visible to HR and the employee's manager only.
  isPrivate      Boolean        @default(false) @map("is_private")
  authorId       String?        @map("author_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@map("hr_feedback")
}

enum HrPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model HrDevelopmentPlan {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  employeeId     String       @map("employee_id") @db.Uuid
  title          String
  focusArea      String?      @map("focus_area")
  /// Planned actions, one per line.
  actions        String       @default("")
  dueDate        DateTime?    @map("due_date") @db.Date
  status         HrPlanStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([employeeId])
  @@map("hr_development_plans")
}

// ─── Time, attendance & leave ───────────────────────────────────────────────────────────────────────────────────────

/// One clock-in/clock-out session.
model HrAttendance {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  /// Work day (company timezone) the session belongs to.
  date           DateTime  @db.Date
  clockIn        DateTime  @map("clock_in") @db.Timestamptz(3)
  clockOut       DateTime? @map("clock_out") @db.Timestamptz(3)
  minutes        Int?
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([employeeId, date])
  @@index([companyId, date])
  @@map("hr_attendance")
}

model HrWorkSchedule {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String
  /// ISO weekdays worked (1 = Monday … 7 = Sunday).
  weekdays       Int[]     @default([1, 2, 3, 4, 5])
  /// "HH:MM" local time.
  startTime      String    @default("09:00") @map("start_time")
  endTime        String    @default("17:00") @map("end_time")
  breakMinutes   Int       @default(60) @map("break_minutes")
  isDefault      Boolean   @default(false) @map("is_default")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employees Employee[] @relation("EmployeeWorkSchedule")

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@map("hr_work_schedules")
}

model HrLeaveType {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  name             String
  paid             Boolean   @default(true)
  /// Default yearly allowance in days (0 = unlimited / not tracked).
  yearlyAllowance  Float     @default(0) @map("yearly_allowance")
  requiresApproval Boolean   @default(true) @map("requires_approval")
  color            String?
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company            @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  allowances HrLeaveAllowance[]
  requests   HrLeaveRequest[]

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@map("hr_leave_types")
}

/// Per-employee override of a leave type's yearly allowance (incl. carry-over).
model HrLeaveAllowance {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  leaveTypeId    String   @map("leave_type_id") @db.Uuid
  year           Int
  days           Float
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company     @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee  Employee    @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  leaveType HrLeaveType @relation(fields: [leaveTypeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@map("hr_leave_allowances")
}

enum HrLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model HrLeaveRequest {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  employeeId     String        @map("employee_id") @db.Uuid
  leaveTypeId    String        @map("leave_type_id") @db.Uuid
  startDate      DateTime      @map("start_date") @db.Date
  endDate        DateTime      @map("end_date") @db.Date
  /// Working days requested (weekends and holidays excluded; 0.5 for a half day).
  days           Float
  reason         String?
  status         HrLeaveStatus @default(PENDING)
  decidedById    String?       @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?     @map("decided_at") @db.Timestamptz(3)
  decisionNote   String?       @map("decision_note")
  createdById    String        @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company     @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee  Employee    @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  leaveType HrLeaveType @relation(fields: [leaveTypeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([organizationId, companyId, status])
  @@index([employeeId, startDate])
  @@map("hr_leave_requests")
}

model HrHoliday {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String
  date           DateTime @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([companyId, date])
  @@map("hr_holidays")
}

// ─── Policies & employee requests ───────────────────────────────────────────────────────────────────────────────────

model HrPolicy {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  title          String
  category       String    @default("general")
  body           String
  /// Bumped on every content change; acknowledgements are per version.
  version        Int       @default(1)
  requiresAck    Boolean   @default(true) @map("requires_ack")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company       @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  acks    HrPolicyAck[]

  @@unique([id, companyId])
  @@index([companyId, publishedAt])
  @@map("hr_policies")
}

model HrPolicyAck {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  policyId       String   @map("policy_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  version        Int
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  policy   HrPolicy @relation(fields: [policyId, companyId], references: [id, companyId], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([policyId, employeeId, version])
  @@map("hr_policy_acks")
}

enum HrRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

/// Generic employee request to HR (equipment, letter, data change...).
model HrEmployeeRequest {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  employeeId     String          @map("employee_id") @db.Uuid
  /// equipment | document | data_change | expense | other
  type           String
  subject        String
  details        String?
  status         HrRequestStatus @default(OPEN)
  resolution     String?
  handledById    String?         @map("handled_by_id") @db.Uuid
  resolvedAt     DateTime?       @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([organizationId, companyId, status])
  @@index([employeeId])
  @@map("hr_employee_requests")
}

// ─── Payroll (payroll.* only) ───────────────────────────────────────────────────────────────────────────────────────

model HrSalaryStructure {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String
  description    String?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company       Company             @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  components    HrSalaryComponent[]
  compensations HrCompensation[]

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@map("hr_salary_structures")
}

enum HrComponentKind {
  ALLOWANCE
  DEDUCTION
}

enum HrComponentCalc {
  FIXED
  PERCENT
}

model HrSalaryComponent {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  structureId    String          @map("structure_id") @db.Uuid
  name           String
  kind           HrComponentKind
  calc           HrComponentCalc @default(FIXED)
  /// FIXED: monthly amount in minor units of the employee's pay currency.
  amountMinor    BigInt?         @map("amount_minor")
  /// PERCENT: basis points of the monthly base salary (1000 = 10%).
  percentBp      Int?            @map("percent_bp")
  position       Int             @default(0)

  company   Company           @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  structure HrSalaryStructure @relation(fields: [structureId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([structureId, position])
  @@map("hr_salary_components")
}

/// An employee's compensation from `effectiveFrom` (latest effective row applies).
model HrCompensation {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  employeeId       String   @map("employee_id") @db.Uuid
  structureId      String?  @map("structure_id") @db.Uuid
  /// Monthly base salary in minor units.
  baseMonthlyMinor BigInt   @map("base_monthly_minor")
  currency         String   @db.Char(3)
  effectiveFrom    DateTime @map("effective_from") @db.Date
  note             String?
  createdById      String   @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company            @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee  Employee           @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  structure HrSalaryStructure? @relation(fields: [structureId, companyId], references: [id, companyId], onDelete: NoAction)

  @@index([employeeId, effectiveFrom])
  @@map("hr_compensations")
}

enum HrPayPeriodStatus {
  OPEN
  CLOSED
}

model HrPayPeriod {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  name           String
  startDate      DateTime          @map("start_date") @db.Date
  endDate        DateTime          @map("end_date") @db.Date
  payDate        DateTime          @map("pay_date") @db.Date
  status         HrPayPeriodStatus @default(OPEN)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company        @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  runs    HrPayrollRun[]

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@map("hr_pay_periods")
}

enum HrPayrollStatus {
  DRAFT
  COMPUTED
  APPROVED
  PAID
}

model HrPayrollRun {
  id                   String          @id @default(uuid(7)) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  companyId            String          @map("company_id") @db.Uuid
  periodId             String          @map("period_id") @db.Uuid
  status               HrPayrollStatus @default(DRAFT)
  currency             String          @db.Char(3)
  totalGrossMinor      BigInt          @default(0) @map("total_gross_minor")
  totalDeductionsMinor BigInt          @default(0) @map("total_deductions_minor")
  totalNetMinor        BigInt          @default(0) @map("total_net_minor")
  computedAt           DateTime?       @map("computed_at") @db.Timestamptz(3)
  approvedById         String?         @map("approved_by_id") @db.Uuid
  approvedAt           DateTime?       @map("approved_at") @db.Timestamptz(3)
  paidAt               DateTime?       @map("paid_at") @db.Timestamptz(3)
  createdById          String          @map("created_by_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company     @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  period   HrPayPeriod @relation(fields: [periodId, companyId], references: [id, companyId], onDelete: Cascade)
  payslips HrPayslip[]

  @@unique([id, companyId])
  @@index([organizationId, companyId, status])
  @@map("hr_payroll_runs")
}

model HrPayslip {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  currency        String   @db.Char(3)
  baseMinor       BigInt   @map("base_minor")
  grossMinor      BigInt   @map("gross_minor")
  deductionsMinor BigInt   @map("deductions_minor")
  netMinor        BigInt   @map("net_minor")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company         @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  run      HrPayrollRun    @relation(fields: [runId, companyId], references: [id, companyId], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  lines    HrPayslipLine[]

  @@unique([id, companyId])
  @@unique([runId, employeeId])
  @@index([employeeId])
  @@map("hr_payslips")
}

enum HrPayslipLineKind {
  EARNING
  DEDUCTION
}

model HrPayslipLine {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  payslipId      String            @map("payslip_id") @db.Uuid
  label          String
  kind           HrPayslipLineKind
  amountMinor    BigInt            @map("amount_minor")
  position       Int               @default(0)

  company Company   @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  payslip HrPayslip @relation(fields: [payslipId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([payslipId, position])
  @@map("hr_payslip_lines")
}

/// Guided hiring journey (/hr/hire): where a person is in "role → description → publish → candidates → interviews → hire".
/// The job, candidates and interviews are the real records; this only remembers the step and the plain-language brief.
model HrHiringJourney {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  jobId          String    @unique @map("job_id") @db.Uuid
  /// role | describe | publish | candidates | interviews | hire | done
  step           String    @default("describe")
  /// What the person said the new hire will do (input for the AI job description).
  brief          String    @default("")
  createdById    String    @map("created_by_id") @db.Uuid
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  job     HrJob   @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([jobId, companyId])
  @@index([organizationId, companyId, completedAt])
  @@map("hr_hiring_journeys")
}

// ─── Workforce planning ─────────────────────────────────────────────────────────────────────────────────────────────

enum HrHeadcountPlanStatus {
  PLANNED
  APPROVED
  HIRING
  FILLED
  CANCELLED
}

enum HrHeadcountPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// A planned role (headcount) for a future quarter: what the company intends to hire, why and at what cost.
model HrHeadcountPlan {
  id              String                @id @default(uuid(7)) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  companyId       String                @map("company_id") @db.Uuid
  title           String
  /// Department id (validated against the company; kept as a plain id so departments stay owned by Organization).
  departmentId    String?               @map("department_id") @db.Uuid
  employmentType  EmploymentType        @default(FULL_TIME) @map("employment_type")
  headcount       Int                   @default(1)
  /// First day of the quarter the role should start in.
  targetStart     DateTime              @map("target_start") @db.Date
  /// Planned yearly cost per person (salary + overhead), minor units of `currency`.
  annualCostMinor BigInt                @default(0) @map("annual_cost_minor")
  currency        String                @db.Char(3)
  priority        HrHeadcountPriority   @default(MEDIUM)
  status          HrHeadcountPlanStatus @default(PLANNED)
  reason          String?
  jobId           String?               @map("job_id") @db.Uuid
  createdById     String                @map("created_by_id") @db.Uuid
  approvedById    String?               @map("approved_by_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  job     HrJob?  @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([id, companyId])
  @@index([organizationId, companyId, targetStart])
  @@map("hr_headcount_plans")
}
