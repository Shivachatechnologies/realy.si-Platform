// AI phone team (src/server/modules/voice): voice agents on Vapi or Retell AI, phone numbers, outbound/inbound calls,
// campaigns and the do-not-call list. CRM leads/contacts, AI employees and users are referenced by plain uuids
// (validated inside the company by the service), so this module adds back-relations only to Company.

enum VoiceProvider {
  VAPI
  RETELL
}

enum VoiceGoal {
  QUALIFY_LEAD
  BOOK_MEETING
  SUPPORT_TRIAGE
  COLLECTIONS_REMINDER
  RECEPTIONIST
}

enum VoiceAgentSync {
  DRAFT
  SYNCED
  ERROR
}

enum VoiceNumberSource {
  PROVIDER
  TWILIO
}

enum VoiceCallDirection {
  OUTBOUND
  INBOUND
}

enum VoiceCallStatus {
  /// Waiting for a person's approval (place_voice_call / voice campaign approval).
  AWAITING_APPROVAL
  /// Approved; waits for the next calling window (callee local time).
  SCHEDULED
  /// Handed to the provider, not yet ringing.
  QUEUED
  RINGING
  IN_PROGRESS
  ENDED
  /// The provider refused or the call errored before connecting.
  FAILED
  /// Not placed: do-not-call, kill switch, missing connection... (blockedReason says why).
  BLOCKED
  CANCELLED
  /// The approval was rejected or expired.
  REJECTED
}

enum VoiceCallOutcome {
  INTERESTED
  NOT_INTERESTED
  MEETING_REQUESTED
  MEETING_BOOKED
  CALLBACK_REQUESTED
  SUPPORT_ISSUE
  PAYMENT_PROMISED
  MESSAGE_TAKEN
  VOICEMAIL
  NO_ANSWER
  WRONG_NUMBER
  DO_NOT_CALL
  OTHER
}

enum VoiceSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  UNKNOWN
}

enum VoiceCampaignStatus {
  DRAFT
  AWAITING_APPROVAL
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

/// How calls reach the phone network: the AI provider's own telephony, or the company's Twilio account (Programmable
/// Voice) bridged to the AI agent.
enum VoiceTelephony {
  PROVIDER
  TWILIO
}

/// How a Twilio call is bridged to the AI agent.
enum VoiceBridgeMode {
  /// Retell: the call is registered on Retell (register-phone-call) and dialled to sip:<call_id>@sip.retellai.com.
  PROVIDER_SIP
  /// Any SIP endpoint of an AI voice platform (e.g. a Vapi SIP number), with optional digest credentials.
  CUSTOM_SIP
  /// Twilio Media Streams to a websocket bridge the company operates (wss://…).
  MEDIA_STREAM
}

enum VoiceRunStatus {
  PLANNED
  AWAITING_APPROVAL
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

enum VoiceRunTargetStatus {
  ELIGIBLE
  SKIPPED
  SCHEDULED
  CALLING
  NO_ANSWER
  QUALIFIED
  NOT_QUALIFIED
  MEETING_BOOKED
  FAILED
}

enum VoiceDncSource {
  MANUAL
  CALLER_REQUEST
}

/// Per-company phone team settings: provider, webhook key, calling rules and inbound routing.
model VoiceSettings {
  companyId           String          @id @map("company_id") @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  provider            VoiceProvider?
  /// Public, unguessable id in the provider webhook URL (/api/v1/webhooks/voice/<provider>/<webhookKey>).
  webhookKey          String          @unique @map("webhook_key")
  /// Shared secret Vapi sends in x-vapi-secret (encrypted; bound to the company).
  vapiSecretEnc       String?         @map("vapi_secret_enc")
  /// Calling window in the callee's local time, minutes after midnight [start, end).
  callingStartMin     Int             @default(540) @map("calling_start_min")
  callingEndMin       Int             @default(1080) @map("calling_end_min")
  /// ISO weekdays (1 = Monday … 7 = Sunday) on which outbound calls may be placed.
  callingDays         Int[]           @default([1, 2, 3, 4, 5]) @map("calling_days")
  maxDurationSec      Int             @default(600) @map("max_duration_sec")
  /// Record calls (the opening line then always announces the recording).
  recordCalls         Boolean         @default(false) @map("record_calls")
  maxConcurrent       Int             @default(2) @map("max_concurrent")
  /// Who receives messages taken by the AI receptionist (null = members with communication.manage).
  voicemailUserId     String?         @map("voicemail_user_id") @db.Uuid
  /// Inbound routing: create a support ticket / a CRM lead when the caller needs one.
  inboundTickets      Boolean         @default(true) @map("inbound_tickets")
  inboundLeads        Boolean         @default(true) @map("inbound_leads")
  /// After each call create follow-up tasks and book requested meetings.
  autoFollowUps       Boolean         @default(true) @map("auto_follow_ups")
  telephony           VoiceTelephony  @default(PROVIDER)
  bridgeMode          VoiceBridgeMode @default(PROVIDER_SIP) @map("bridge_mode")
  /// CUSTOM_SIP target, e.g. sip:assistant@sip.vapi.ai.
  bridgeSipUri        String?         @map("bridge_sip_uri")
  sipUsername         String?         @map("sip_username")
  /// SIP digest password (encrypted, bound to the company).
  sipPasswordEnc      String?         @map("sip_password_enc")
  /// MEDIA_STREAM websocket (wss://…).
  mediaStreamUrl      String?         @map("media_stream_url")
  /// Caller id on Twilio (E.164) when telephony is TWILIO.
  twilioFromNumber    String?         @map("twilio_from_number")
  /// Twilio real-time transcription of bridged calls (live transcript).
  liveTranscription   Boolean         @default(true) @map("live_transcription")
  /// Where "transfer to a person" / "take over" sends a live call (E.164).
  humanTransferNumber String?         @map("human_transfer_number")
  /// Unanswered campaign calls are retried this many extra times, this many minutes apart.
  retryMaxAttempts    Int             @default(1) @map("retry_max_attempts")
  retryDelayMin       Int             @default(240) @map("retry_delay_min")
  setupCompletedAt    DateTime?       @map("setup_completed_at") @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@map("voice_settings")
}

/// A voice agent: an AI employee's voice persona, configured on the provider as an assistant/agent.
model VoiceAgent {
  id               String         @id @default(uuid(7)) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  companyId        String         @map("company_id") @db.Uuid
  name             String
  /// AI employee (workforce) this agent speaks for; plain uuid validated on write.
  aiEmployeeId     String?        @map("ai_employee_id") @db.Uuid
  goal             VoiceGoal
  provider         VoiceProvider
  /// BCP-47 language of the conversation (en-US, de-DE, hi-IN, zh-CN, ar-AE).
  language         String         @default("en-US")
  /// Provider voice id (empty = provider default).
  voiceId          String?        @map("voice_id")
  /// Greeting after the mandatory AI (and recording) disclosure.
  greeting         String?
  instructions     String?
  /// Offers, prices and policies the founder wants the agent to use (quoted verbatim, never invented).
  offerNotes       String?        @map("offer_notes")
  /// Compiled company knowledge (Brain facts, products, help articles) sent to the provider.
  knowledge        String?
  knowledgeBuiltAt DateTime?      @map("knowledge_built_at") @db.Timestamptz(3)
  externalAgentId  String?        @map("external_agent_id")
  /// Retell LLM id (Retell agents run on a separate "Retell LLM" object).
  externalLlmId    String?        @map("external_llm_id")
  syncStatus       VoiceAgentSync @default(DRAFT) @map("sync_status")
  syncError        String?        @map("sync_error")
  syncedAt         DateTime?      @map("synced_at") @db.Timestamptz(3)
  archivedAt       DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdById      String         @map("created_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company            @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  numbers   VoicePhoneNumber[]
  calls     VoiceCall[]
  campaigns VoiceCampaign[]

  @@unique([id, companyId])
  @@index([organizationId, companyId, archivedAt])
  @@map("voice_agents")
}

/// A phone number on the provider (bought there, or a Twilio number imported into Vapi).
model VoicePhoneNumber {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  provider       VoiceProvider
  /// Provider id of the number (Vapi phone-number id; Retell uses the E.164 number itself).
  externalId     String            @map("external_id")
  /// E.164.
  number         String
  label          String?
  source         VoiceNumberSource @default(PROVIDER)
  twilioSid      String?           @map("twilio_sid")
  /// Agent answering inbound calls (AI receptionist).
  inboundAgentId String?           @map("inbound_agent_id") @db.Uuid
  releasedAt     DateTime?         @map("released_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company         @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  inboundAgent VoiceAgent?     @relation(fields: [inboundAgentId, companyId], references: [id, companyId], onDelete: NoAction)
  calls        VoiceCall[]
  campaigns    VoiceCampaign[]

  @@unique([id, companyId])
  @@unique([companyId, provider, externalId])
  @@index([provider, number])
  @@map("voice_phone_numbers")
}

/// An outbound call list run by one agent from one number; approved once as a whole.
model VoiceCampaign {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  companyId      String              @map("company_id") @db.Uuid
  name           String
  agentId        String              @map("agent_id") @db.Uuid
  numberId       String              @map("number_id") @db.Uuid
  /// What the calls are about (passed to the agent as context).
  purpose        String?
  status         VoiceCampaignStatus @default(DRAFT)
  approvalId     String?             @map("approval_id") @db.Uuid
  /// Live calls of this campaign at once (null = the company limit only).
  maxConcurrent  Int?                @map("max_concurrent")
  createdById    String              @map("created_by_id") @db.Uuid
  startedAt      DateTime?           @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?           @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company          @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  agent   VoiceAgent       @relation(fields: [agentId, companyId], references: [id, companyId], onDelete: NoAction)
  number  VoicePhoneNumber @relation(fields: [numberId, companyId], references: [id, companyId], onDelete: NoAction)
  calls   VoiceCall[]

  @@unique([id, companyId])
  @@index([organizationId, companyId, status])
  @@map("voice_campaigns")
}

/// One phone call (outbound or inbound) with its transcript, analysis and the records created from it.
model VoiceCall {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  companyId          String             @map("company_id") @db.Uuid
  direction          VoiceCallDirection
  status             VoiceCallStatus
  provider           VoiceProvider?
  externalCallId     String?            @map("external_call_id")
  agentId            String?            @map("agent_id") @db.Uuid
  numberId           String?            @map("number_id") @db.Uuid
  campaignId         String?            @map("campaign_id") @db.Uuid
  /// E.164 of the person called (outbound) or of the company number (inbound).
  toNumber           String             @map("to_number")
  fromNumber         String?            @map("from_number")
  leadId             String?            @map("lead_id") @db.Uuid
  contactId          String?            @map("contact_id") @db.Uuid
  /// Display name of the person (snapshot).
  subjectName        String?            @map("subject_name")
  /// Why the call is made (context for the agent).
  purpose            String?
  approvalId         String?            @map("approval_id") @db.Uuid
  requestedById      String?            @map("requested_by_id") @db.Uuid
  requestedByProfile String?            @map("requested_by_profile")
  scheduledFor       DateTime?          @map("scheduled_for") @db.Timestamptz(3)
  blockedReason      String?            @map("blocked_reason")
  error              String?
  startedAt          DateTime?          @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime?          @map("ended_at") @db.Timestamptz(3)
  durationSec        Int?               @map("duration_sec")
  endedReason        String?            @map("ended_reason")
  /// [{ role: "agent" | "caller", text, at? }] as delivered by the provider.
  transcript         Json               @default("[]")
  summary            String?
  outcome            VoiceCallOutcome?
  sentiment          VoiceSentiment?
  /// Structured post-call analysis returned by the provider.
  analysis           Json               @default("{}")
  /// Provider-hosted recording (only kept when recording is enabled).
  recordingUrl       String?            @map("recording_url")
  costMinor          BigInt?            @map("cost_minor")
  costCurrency       String             @default("USD") @map("cost_currency") @db.Char(3)
  /// Post-call processing (CRM activity, follow-ups, meetings, tickets) finished.
  processedAt        DateTime?          @map("processed_at") @db.Timestamptz(3)
  /// [{ type, id, label }] records created from this call.
  results            Json               @default("[]")
  /// Telephony layer of the call (null = the AI provider's own) and its Twilio CallSid.
  telephony          VoiceTelephony?
  telephonySid       String?            @map("telephony_sid")
  /// Price of the Twilio leg in minor units of costCurrency (the AI provider's price stays in costMinor).
  telephonyCostMinor BigInt?            @map("telephony_cost_minor")
  /// Vapi live-control URL (monitor.controlUrl), encrypted: it can end or redirect the call.
  controlUrlEnc      String?            @map("control_url_enc")
  /// The AI voice is muted (Vapi mute-assistant).
  muted              Boolean            @default(false)
  /// Number the call was transferred to (a person), and who took the call over.
  transferredTo      String?            @map("transferred_to")
  takenOverAt        DateTime?          @map("taken_over_at") @db.Timestamptz(3)
  takenOverById      String?            @map("taken_over_by_id") @db.Uuid
  /// 1 = first try; retries and callbacks link to the call they repeat.
  attempt            Int                @default(1)
  retryOfId          String?            @map("retry_of_id") @db.Uuid
  /// A person set the outcome by hand.
  outcomeSetById     String?            @map("outcome_set_by_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  company         Company               @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  agent           VoiceAgent?           @relation(fields: [agentId, companyId], references: [id, companyId], onDelete: NoAction)
  number          VoicePhoneNumber?     @relation(fields: [numberId, companyId], references: [id, companyId], onDelete: NoAction)
  campaign        VoiceCampaign?        @relation(fields: [campaignId, companyId], references: [id, companyId], onDelete: NoAction)
  transcriptLines VoiceTranscriptLine[]

  @@unique([id, companyId])
  @@unique([provider, externalCallId])
  @@index([organizationId, companyId, createdAt])
  @@index([companyId, status, scheduledFor])
  @@index([companyId, leadId])
  @@index([companyId, contactId])
  @@index([campaignId])
  @@index([telephonySid])
  @@map("voice_calls")
}

/// Incremental transcript of a call as the provider streams it (Vapi transcript messages, Retell transcript_updated,
/// Twilio real-time transcription). The final transcript stays on VoiceCall.transcript.
model VoiceTranscriptLine {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  callId         String   @map("call_id") @db.Uuid
  /// agent | caller | human (a person who took the call over).
  role           String
  text           String
  /// Seconds from call start, when reported.
  atSec          Int?     @map("at_sec")
  /// vapi | retell | twilio
  source         String
  /// Provider-derived key so a redelivered event is stored once.
  dedupeKey      String   @map("dedupe_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company   @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  call    VoiceCall @relation(fields: [callId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([callId, dedupeKey])
  @@index([callId, createdAt])
  @@map("voice_transcript_lines")
}

/// Autonomous calling campaign ("call 100 qualified leads…"): eligibility, prioritisation, per-lead briefs, then a
/// VoiceCampaign executed by the dialer; results (qualified, meetings, follow-ups) roll up into the report.
model VoiceCallingRun {
  id                 String         @id @default(uuid(7)) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  name               String
  /// The instruction in plain words ("Call 100 qualified leads and book demos").
  goal               String
  /// { stages, minScore, tags, sources, maxCalls, consent, cooldownDays }
  criteria           Json           @default("{}")
  agentId            String         @map("agent_id") @db.Uuid
  numberId           String         @map("number_id") @db.Uuid
  purpose            String
  maxConcurrent      Int?           @map("max_concurrent")
  status             VoiceRunStatus @default(PLANNED)
  approvalId         String?        @map("approval_id") @db.Uuid
  campaignId         String?        @unique @map("campaign_id") @db.Uuid
  /// { considered, eligible, skipped: { reason: count } }
  eligibility        Json           @default("{}")
  /// Final report (numbers computed from calls, meetings and follow-ups).
  report             Json           @default("{}")
  summary            String?
  requestedById      String         @map("requested_by_id") @db.Uuid
  requestedByProfile String?        @map("requested_by_profile")
  startedAt          DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company              @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  targets VoiceCallingTarget[]

  @@unique([id, companyId])
  @@index([organizationId, companyId, status])
  @@map("voice_calling_runs")
}

/// One person considered by a calling run: why they are (not) called, their priority, brief and result.
model VoiceCallingTarget {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  companyId      String               @map("company_id") @db.Uuid
  runId          String               @map("run_id") @db.Uuid
  leadId         String?              @map("lead_id") @db.Uuid
  contactId      String?              @map("contact_id") @db.Uuid
  name           String
  phone          String?
  /// 0–100, higher is called first.
  priority       Int                  @default(0)
  reasons        String[]             @default([])
  /// Context brief compiled from CRM records (passed to the agent as the call purpose).
  brief          String?
  status         VoiceRunTargetStatus @default(ELIGIBLE)
  skipReason     String?              @map("skip_reason")
  callId         String?              @map("call_id") @db.Uuid
  meetingId      String?              @map("meeting_id") @db.Uuid
  followUps      Int                  @default(0) @map("follow_ups")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company         @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  run     VoiceCallingRun @relation(fields: [runId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([runId, status])
  @@index([callId])
  @@map("voice_calling_targets")
}

/// Numbers that must never be called (manual entries and callers who asked not to be called again).
model VoiceDoNotCall {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  /// E.164.
  phone          String
  reason         String?
  source         VoiceDncSource @default(MANUAL)
  callId         String?        @map("call_id") @db.Uuid
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([companyId, phone])
  @@map("voice_do_not_call")
}
