{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/server/*": [
        "../backend/src/server/*"
      ],
      "@/worker/*": [
        "../backend/src/worker/*"
      ],
      "@/generated/*": [
        "../database/src/generated/*"
      ],
      "@/lib/*": [
        "../shared-utils/src/lib/*"
      ],
      "@/i18n/*": [
        "../shared-utils/src/i18n/*"
      ],
      "@realy/auth-core": [
        "../auth-core/src/index.ts"
      ],
      "@realy/shared-types/*": [
        "../shared-types/src/*"
      ],
      "@/i18n/messages/*": [
        "../../apps/user/src/i18n/messages/*"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules"]
}
