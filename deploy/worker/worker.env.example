# Environment of the worker service (names only — set real values in your platform's secret store).
# The worker needs the same database, encryption key and provider credentials as the web app.
NODE_ENV=production
REALY_SERVICE=worker
DATABASE_URL=
REDIS_URL=
REALY_ENCRYPTION_KEY=
APP_URL=
# AI + email + observability (same values as the web app)
ANTHROPIC_API_KEY=
AGENT_MODEL=
AI_DAILY_TOKEN_LIMIT=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Integration OAuth apps (needed for token refresh during syncs) — every *_CLIENT_ID / *_CLIENT_SECRET the web app has.
# Worker tuning (all optional; defaults shown)
WORKER_ROLES=all
WORKER_AI_CONCURRENCY=2
WORKER_EVENTS_CONCURRENCY=4
WORKER_MODULE_CONCURRENCY=4
WORKER_SCHEDULE_CONCURRENCY=4
WORKER_WEBHOOK_CONCURRENCY=8
WORKER_EMAIL_CONCURRENCY=5
WORKER_AI_LOCK_MS=60000
WORKER_SHUTDOWN_TIMEOUT_MS=25000
# Redis command budget (docs/deployment.md §4): idle polling and recurring-job checks.
WORKER_DRAIN_DELAY_S=60
WORKER_STALLED_INTERVAL_MS=120000
WORKER_MAX_STALLED_COUNT=1
WORKER_SCHEDULE_TICK_MS=15000
WORKER_HEARTBEAT_MS=60000
WORKER_RELAY_IDLE_MAX_MS=2000
